<UserControl x:Class="Contain.Desktop.Views.EnvironmentCheckView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:model="clr-namespace:Contain.Desktop.Model;assembly=Contain.Desktop.Model">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16,24,24">
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock Text="检查项目环境" Style="{StaticResource PageTitle}" AutomationProperties.AutomationId="EnvironmentPageTitle" />
            <TextBlock Text="选择项目文件夹并点击“开始检查”，查看环境就绪状态、预览构建步骤并生成实际产物。" Style="{StaticResource MutedText}" Margin="0,0,0,20" AutomationProperties.AutomationId="EnvironmentPurposeText" />

            <Border Style="{StaticResource Surface}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="项目文件夹" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding EnvironmentCheck.ProjectName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.AutomationId="SelectedProjectName" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="选择文件夹" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnPickFolder" IsEnabled="{Binding EnvironmentCheck.CanEditProjectSelection}" AutomationProperties.AutomationId="PickProjectFolder">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                    <ui:TextBox Margin="0,12,0,0" Text="{Binding EnvironmentCheck.FolderInput, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EnvironmentCheck.IsBuilding}" PlaceholderText="点击右侧“选择文件夹”，或直接粘贴本地项目目录路径" AutomationProperties.AutomationId="ProjectPathInput" AutomationProperties.Name="项目文件夹路径" />
                    <TextBlock Text="{Binding EnvironmentCheck.SelectionScopeNote}" Style="{StaticResource MutedText}" Margin="0,10,0,0" Visibility="{Binding EnvironmentCheck.SelectionScopeNote, Converter={StaticResource TextVisibility}}" AutomationProperties.AutomationId="ProjectScopeNote" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ui:Button Content="开始检查" Appearance="Primary" Padding="24,12" Click="OnStartCheck" IsEnabled="{Binding EnvironmentCheck.CanStartCheck}" AutomationProperties.AutomationId="StartEnvironmentCheck">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" /></ui:Button.Icon>
                </ui:Button>
            </StackPanel>

            <Border Style="{StaticResource Surface}" Visibility="{Binding EnvironmentCheck.IsChecking, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CheckingProgressSurface">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding EnvironmentCheck.CheckingBannerText}" TextWrapping="Wrap" AutomationProperties.AutomationId="CheckingProgressBanner" />
                </StackPanel>
            </Border>

            <Border CornerRadius="10" Padding="20" Margin="0,0,0,16" BorderThickness="1" Visibility="{Binding EnvironmentCheck.HasOutcome, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="EnvironmentOutcomeSurface">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EnvironmentCheck.Outcome}" Value="{x:Static model:EnvironmentOutcomeKind.Ready}">
                                <Setter Property="Background" Value="#EAF5F1" />
                                <Setter Property="BorderBrush" Value="#137D74" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EnvironmentCheck.Outcome}" Value="{x:Static model:EnvironmentOutcomeKind.ActionRequired}">
                                <Setter Property="Background" Value="#FFF8EB" />
                                <Setter Property="BorderBrush" Value="#D99B26" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EnvironmentCheck.Outcome}" Value="{x:Static model:EnvironmentOutcomeKind.InsufficientInfo}">
                                <Setter Property="Background" Value="#EEF5FB" />
                                <Setter Property="BorderBrush" Value="#4B7AA8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EnvironmentCheck.Outcome}" Value="{x:Static model:EnvironmentOutcomeKind.CheckerError}">
                                <Setter Property="Background" Value="#FFF0ED" />
                                <Setter Property="BorderBrush" Value="#B84A39" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding EnvironmentCheck.OutcomeBadge}" FontSize="12" FontWeight="SemiBold" AutomationProperties.AutomationId="EnvironmentOutcomeBadge" />
                        <TextBlock Grid.Column="1" Text="{Binding EnvironmentCheck.LastCheckedText}" Style="{StaticResource MutedText}" FontSize="12" Margin="12,0,0,0" Visibility="{Binding EnvironmentCheck.LastCheckedText, Converter={StaticResource TextVisibility}}" AutomationProperties.AutomationId="EnvironmentCheckedTime" />
                    </Grid>
                    <TextBlock Text="{Binding EnvironmentCheck.Headline}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="EnvironmentHeadline" />
                    <TextBlock Text="{Binding EnvironmentCheck.OutcomeNote}" Style="{StaticResource MutedText}" TextWrapping="Wrap" AutomationProperties.AutomationId="EnvironmentOutcomeNote" />
                    <TextBlock Text="{Binding EnvironmentCheck.ComparisonNote}" Foreground="#7A5200" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding EnvironmentCheck.ComparisonNote, Converter={StaticResource TextVisibility}}" AutomationProperties.AutomationId="EnvironmentComparisonNote" />
                    <TextBox Text="{Binding EnvironmentCheck.ErrorDetail, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="#963D2E" Margin="0,12,0,0" Visibility="{Binding EnvironmentCheck.ErrorDetail, Converter={StaticResource TextVisibility}}" AutomationProperties.AutomationId="EnvironmentErrorDetail" AutomationProperties.Name="检查错误诊断" />

                    <Border Background="#FFF0ED" BorderBrush="#B84A39" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0" Visibility="{Binding EnvironmentCheck.HasRecheckFailure, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="RecheckFailureSurface">
                        <StackPanel>
                            <TextBlock Text="{Binding EnvironmentCheck.RecheckFailureTitle}" Foreground="#8F2D1E" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="RecheckFailureTitle" />
                            <TextBlock Text="{Binding EnvironmentCheck.RecheckFailureText}" Foreground="#8F2D1E" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.AutomationId="RecheckFailureText" />
                            <TextBox Text="{Binding EnvironmentCheck.RecheckFailureDetail, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="#963D2E" Margin="0,6,0,0" Visibility="{Binding EnvironmentCheck.RecheckFailureDetail, Converter={StaticResource TextVisibility}}" AutomationProperties.AutomationId="RecheckFailureDetail" AutomationProperties.Name="重新检查失败诊断" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,16,0,0">
                        <ui:Button Content="重新检查" Margin="0,0,10,0" Click="OnStartCheck" IsEnabled="{Binding EnvironmentCheck.CanRecheck}" AutomationProperties.AutomationId="RecheckEnvironment">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="{Binding EnvironmentCheck.DetailedReportButtonText}" Appearance="Transparent" Click="OnToggleReport" IsEnabled="{Binding EnvironmentCheck.CanToggleDetailedReport}" AutomationProperties.AutomationId="ToggleDetailedReport" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Surface}" Visibility="{Binding EnvironmentCheck.HasActionItems, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="EnvironmentActionSurface">
                <StackPanel>
                    <TextBlock Text="需要优先补齐的项目" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding EnvironmentCheck.ActionItems}" AutomationProperties.AutomationId="EnvironmentActionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFDFC" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" Foreground="#9A6400" FontWeight="SemiBold" FontSize="12" Margin="12,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBox Text="{Binding OfficialGuidanceLine, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="#0E5A53" Margin="0,6,0,0" Visibility="{Binding OfficialGuidanceLine, Converter={StaticResource TextVisibility}}" />
                                        <TextBox Text="{Binding RemedyLine, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" Visibility="{Binding RemedyLine, Converter={StaticResource TextVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Surface}" Visibility="{Binding EnvironmentCheck.HasResolvedItems, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="EnvironmentResolvedSurface">
                <StackPanel>
                    <TextBlock Text="{Binding EnvironmentCheck.ResolvedSectionTitle}" Style="{StaticResource SectionTitle}" AutomationProperties.AutomationId="EnvironmentResolvedTitle" />
                    <ItemsControl ItemsSource="{Binding EnvironmentCheck.ResolvedItems}" AutomationProperties.AutomationId="EnvironmentResolvedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F2FAF6" BorderBrush="#137D74" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayTitle}" Foreground="#0E5A53" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" Foreground="#137D74" FontWeight="SemiBold" FontSize="12" Margin="12,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Surface}" Visibility="{Binding EnvironmentCheck.HasPendingItems, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="EnvironmentPendingSurface">
                <StackPanel>
                    <TextBlock Text="待确认项（需人工确认或补充清单）" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding EnvironmentCheck.PendingItems}" AutomationProperties.AutomationId="EnvironmentPendingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFDFC" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" Foreground="#2B5B84" FontWeight="SemiBold" FontSize="12" Margin="12,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBox Text="{Binding RemedyLine, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" Visibility="{Binding RemedyLine, Converter={StaticResource TextVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Surface}" Visibility="{Binding EnvironmentCheck.ShowProjectBuildSection, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="ProjectBuildSurface">
                <StackPanel>
                    <TextBlock Text="构建项目" Style="{StaticResource SectionTitle}" AutomationProperties.AutomationId="BuildSectionTitle" />

                    <Border Background="#F8FAFB" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,6,0,0" Visibility="{Binding EnvironmentCheck.HasBuildPrerequisiteBlocker, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding EnvironmentCheck.BuildPrerequisiteMessage}" Foreground="#5A4618" TextWrapping="Wrap" AutomationProperties.AutomationId="BuildPrerequisiteNote" />
                    </Border>

                    <StackPanel Visibility="{Binding EnvironmentCheck.ShowBuildStepsPreview, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="项目：" Foreground="{StaticResource MutedBrush}" />
                                    <Run Text="{Binding EnvironmentCheck.BuildPreviewProjectName, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="BuildPreviewWorkingDir">
                                    <Run Text="工作目录：" Foreground="{StaticResource MutedBrush}" />
                                    <Run Text="{Binding EnvironmentCheck.BuildPreviewWorkingDirectory, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding EnvironmentCheck.BuildPreviewStepsSummary}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="BuildPreviewStepsSummary" />
                                <TextBlock Text="{Binding EnvironmentCheck.BuildPreviewArtifactHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding EnvironmentCheck.BuildPreviewArtifactHint, Converter={StaticResource TextVisibility}}" AutomationProperties.AutomationId="BuildPreviewArtifactHint" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="{Binding EnvironmentCheck.StartBuildButtonText}" Appearance="Primary" Padding="22,10" Margin="16,0,0,0" VerticalAlignment="Top" Click="OnStartBuild" IsEnabled="{Binding EnvironmentCheck.CanStartBuild}" Visibility="{Binding EnvironmentCheck.CanShowStartBuild, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="StartProjectBuild">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" /></ui:Button.Icon>
                            </ui:Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding EnvironmentCheck.BuildPreviewSteps}" Margin="0,10,0,0" AutomationProperties.AutomationId="BuildPreviewStepsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAFDFC" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayHeader}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding ExpectationText}" Style="{StaticResource MutedText}" FontSize="12" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Header="查看完整命令" IsExpanded="{Binding EnvironmentCheck.BuildCommandsExpanded, Mode=TwoWay}" Margin="0,4,0,0" AutomationProperties.AutomationId="BuildCommandsExpander">
                            <Border Background="#F7FAF9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                <TextBox Text="{Binding EnvironmentCheck.BuildFullCommandsText, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" MaxHeight="220" AutomationProperties.AutomationId="BuildFullCommandsText" AutomationProperties.Name="完整构建与验证命令" />
                            </Border>
                        </Expander>
                    </StackPanel>

                    <Border Background="#F7FAF9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0" Visibility="{Binding EnvironmentCheck.IsBuilding, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding EnvironmentCheck.BuildProgressText}" TextWrapping="Wrap" AutomationProperties.AutomationId="BuildProgressBanner" />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8" Padding="16" Margin="0,12,0,0" BorderThickness="1" Visibility="{Binding EnvironmentCheck.HasBuildOutcome, Converter={StaticResource BoolVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EnvironmentCheck.BuildOutcome}" Value="{x:Static model:BuildOutcomeKind.Succeeded}">
                                        <Setter Property="Background" Value="#EAF5F1" />
                                        <Setter Property="BorderBrush" Value="#137D74" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EnvironmentCheck.BuildOutcome}" Value="{x:Static model:BuildOutcomeKind.Failed}">
                                        <Setter Property="Background" Value="#FFF0ED" />
                                        <Setter Property="BorderBrush" Value="#B84A39" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding EnvironmentCheck.BuildOutcomeBadge}" FontSize="12" FontWeight="SemiBold" AutomationProperties.AutomationId="BuildOutcomeBadge" />
                                <TextBlock Grid.Column="1" Text="{Binding EnvironmentCheck.BuildCheckedTimeText}" Style="{StaticResource MutedText}" FontSize="12" Margin="12,0,0,0" AutomationProperties.AutomationId="BuildOutcomeTime" />
                            </Grid>
                            <TextBlock Text="{Binding EnvironmentCheck.BuildHeadline}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.AutomationId="BuildHeadlineText" />
                            <TextBlock Text="{Binding EnvironmentCheck.BuildNote}" Style="{StaticResource MutedText}" TextWrapping="Wrap" AutomationProperties.AutomationId="BuildNoteText" />

                            <TextBox Text="{Binding EnvironmentCheck.BuildFailureErrorSummary, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="#8F2D1E" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" MaxHeight="180" Margin="0,10,0,0" Visibility="{Binding EnvironmentCheck.BuildFailureErrorSummary, Converter={StaticResource TextVisibility}}" AutomationProperties.AutomationId="BuildFailureErrorText" AutomationProperties.Name="构建失败具体错误" />

                            <ItemsControl ItemsSource="{Binding EnvironmentCheck.BuildStepRows}" Margin="0,10,0,0" Visibility="{Binding EnvironmentCheck.HasBuildStepRows, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="BuildStepResultsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SummaryLine}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" FontWeight="SemiBold" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="0,12,0,0">
                                <ui:Button Content="打开产物文件夹" Appearance="Primary" Margin="0,0,10,0" Click="OnOpenArtifactFolder" Visibility="{Binding EnvironmentCheck.CanOpenArtifactFolder, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="OpenArtifactFolderButton">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="{Binding EnvironmentCheck.BuildLogButtonText}" Appearance="Transparent" Click="OnToggleBuildLog" IsEnabled="{Binding EnvironmentCheck.CanToggleBuildLog}" AutomationProperties.AutomationId="ToggleBuildLogButton" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#F7FAF9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0" Visibility="{Binding EnvironmentCheck.ShowBuildLog, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="构建日志" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Content="复制构建日志" Appearance="Transparent" Click="OnCopyBuildLog" AutomationProperties.AutomationId="CopyBuildLogButton" />
                            </Grid>
                            <TextBox Text="{Binding EnvironmentCheck.BuildLogText, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" MaxHeight="320" AutomationProperties.AutomationId="BuildLogText" AutomationProperties.Name="构建详细日志" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Expander Header="{Binding EnvironmentCheck.PassedHeader}" IsExpanded="{Binding EnvironmentCheck.PassedExpanded, Mode=TwoWay}" Margin="0,0,0,16" Visibility="{Binding EnvironmentCheck.HasPassedItems, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="PassedItemsExpander">
                <Border Style="{StaticResource Surface}" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding EnvironmentCheck.PassedItems}" AutomationProperties.AutomationId="EnvironmentPassedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SummaryLine}" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" Margin="12,2,0,0" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Expander>

            <Border Style="{StaticResource Surface}" Visibility="{Binding EnvironmentCheck.ShowDetailedReport, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="DetailedReportSurface">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="详细检查报告" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1" Content="复制报告" Appearance="Transparent" Click="OnCopyReport" AutomationProperties.AutomationId="CopyEnvironmentReport" />
                    </Grid>
                    <TextBox Text="{Binding EnvironmentCheck.DetailedReportText, Mode=OneWay}" Style="{StaticResource SelectableText}" MaxHeight="360" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" AutomationProperties.AutomationId="EnvironmentDetailedReport" AutomationProperties.Name="详细环境检查报告" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
