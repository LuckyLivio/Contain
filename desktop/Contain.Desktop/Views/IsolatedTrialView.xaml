<UserControl x:Class="Contain.Desktop.Views.IsolatedTrialView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:model="clr-namespace:Contain.Desktop.Model;assembly=Contain.Desktop.Model">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16,24,24">
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">
            <!-- Header -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="隔离试用" Style="{StaticResource PageTitle}" Margin="0" AutomationProperties.AutomationId="IsolatedTrialPageTitle" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#EAF5F1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsolatedTrial.IsCapabilityBlocked}" Value="True">
                                        <Setter Property="Background" Value="#FDE3DC" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsolatedTrial.IsCheckingCapability}" Value="True">
                                        <Setter Property="Background" Value="#E4EFF9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding IsolatedTrial.CapabilityBadgeText}" FontSize="12" FontWeight="SemiBold" AutomationProperties.AutomationId="TrialCapabilityBadge" />
                    </Border>
                    <ui:Button Content="重新检测" Appearance="Transparent" Padding="10,6" Click="OnRecheckCapability" IsEnabled="{Binding IsolatedTrial.CanRecheckCapability}" AutomationProperties.AutomationId="RecheckSandboxCapabilityButton">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
            <TextBlock Text="选择单个本地 .exe 或便携软件文件夹即可只读查看信息并计算入口 SHA-256；本机启用 Windows 沙盒后，可在断网、禁用剪贴板的临时沙箱中试运行并在关闭后自动丢弃来宾改动。" Style="{StaticResource MutedText}" Margin="0,0,0,16" AutomationProperties.AutomationId="IsolatedTrialPurposeText" />

            <!-- Front-and-center current session / preparation / ended result card -->
            <Border CornerRadius="10" Padding="20" Margin="0,0,0,16" BorderThickness="1" Visibility="{Binding IsolatedTrial.HasSessionCard, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TrialSessionCard">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsolatedTrial.Phase}" Value="{x:Static model:IsolatedTrialPhase.PreparingInput}">
                                <Setter Property="Background" Value="#EEF5FB" />
                                <Setter Property="BorderBrush" Value="#4B7AA8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsolatedTrial.Phase}" Value="{x:Static model:IsolatedTrialPhase.StartingSandbox}">
                                <Setter Property="Background" Value="#EEF5FB" />
                                <Setter Property="BorderBrush" Value="#4B7AA8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsolatedTrial.Phase}" Value="{x:Static model:IsolatedTrialPhase.ProgramStarted}">
                                <Setter Property="Background" Value="#EAF5F1" />
                                <Setter Property="BorderBrush" Value="#137D74" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsolatedTrial.Phase}" Value="{x:Static model:IsolatedTrialPhase.ProgramExitedAfterStart}">
                                <Setter Property="Background" Value="#EAF5F1" />
                                <Setter Property="BorderBrush" Value="#137D74" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsolatedTrial.Phase}" Value="{x:Static model:IsolatedTrialPhase.SandboxOpened}">
                                <Setter Property="Background" Value="#EEF5FB" />
                                <Setter Property="BorderBrush" Value="#4B7AA8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsolatedTrial.Phase}" Value="{x:Static model:IsolatedTrialPhase.Ended}">
                                <Setter Property="Background" Value="#F2F8F6" />
                                <Setter Property="BorderBrush" Value="#137D74" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsolatedTrial.Phase}" Value="{x:Static model:IsolatedTrialPhase.RecoveredRunning}">
                                <Setter Property="Background" Value="#FFFBF2" />
                                <Setter Property="BorderBrush" Value="#D99B26" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsolatedTrial.Phase}" Value="{x:Static model:IsolatedTrialPhase.Unconfirmed}">
                                <Setter Property="Background" Value="#FFF8EB" />
                                <Setter Property="BorderBrush" Value="#D99B26" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsolatedTrial.Phase}" Value="{x:Static model:IsolatedTrialPhase.Failed}">
                                <Setter Property="Background" Value="#FFF0ED" />
                                <Setter Property="BorderBrush" Value="#B84A39" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" Visibility="{Binding IsolatedTrial.IsRecovering, Converter={StaticResource BoolVisibility}}" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding IsolatedTrial.StagingProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsolatedTrial.IsStagingProgressIndeterminate, Mode=OneWay}" Height="6" Margin="0,0,0,12" Visibility="{Binding IsolatedTrial.IsPreparingInput, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TrialStagingProgressBar" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" Visibility="{Binding IsolatedTrial.IsStarting, Converter={StaticResource BoolVisibility}}" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" Visibility="{Binding IsolatedTrial.IsStopping, Converter={StaticResource BoolVisibility}}" />

                    <!-- Clean stage badges separating Sandbox instance state from Launch Action / Host Staging state -->
                    <WrapPanel Margin="0,0,0,10">
                        <Border Background="#D4EFE7" CornerRadius="6" Padding="10,4" Margin="0,0,8,4">
                            <TextBlock FontSize="12" FontWeight="SemiBold" AutomationProperties.AutomationId="TrialSandboxStageBadge">
                                <Run Text="沙箱实例：" /><Run Text="{Binding IsolatedTrial.SandboxStageBadge, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Background="#E4EFF9" CornerRadius="6" Padding="10,4" Margin="0,0,8,4" Visibility="{Binding IsolatedTrial.ShowProgramStageBadge, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Foreground="#24527A" FontSize="12" FontWeight="SemiBold" Text="{Binding IsolatedTrial.ProgramStageBadge, Mode=OneWay}" AutomationProperties.AutomationId="TrialProgramStageBadge" />
                        </Border>
                        <Border Background="#EEF2F2" CornerRadius="6" Padding="10,4" Margin="0,0,8,4" Visibility="{Binding IsolatedTrial.ShowStagingStageBadge, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Foreground="#354643" FontSize="12" FontWeight="SemiBold" AutomationProperties.AutomationId="TrialStagingStageBadge">
                                <Run Text="暂存目录：" /><Run Text="{Binding IsolatedTrial.StagingStageBadge, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="{Binding IsolatedTrial.SessionHeadline}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.AutomationId="TrialSessionHeadline" />
                    <TextBlock Text="{Binding IsolatedTrial.SessionSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="TrialSessionSummary" />

                    <TextBlock Text="{Binding IsolatedTrial.StagingProgressText}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding IsolatedTrial.HasStagingProgressText, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TrialStagingProgressText" />

                    <!-- Prominent truthful cleanup status -->
                    <Border CornerRadius="6" Padding="12,8" Margin="0,12,0,0" BorderThickness="1" Visibility="{Binding IsolatedTrial.HasCleanupStatus, Converter={StaticResource BoolVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E6F4EF" />
                                <Setter Property="BorderBrush" Value="#8DC4B7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsolatedTrial.IsCleanupWarning}" Value="True">
                                        <Setter Property="Background" Value="#FFF4E5" />
                                        <Setter Property="BorderBrush" Value="#D99B26" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding IsolatedTrial.CleanupStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="TrialCleanupStatus">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0E5A53" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsolatedTrial.IsCleanupWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#8A4B00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="{Binding IsolatedTrial.FailureNextStep}" Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="{Binding IsolatedTrial.FailureNextStep, Converter={StaticResource TextVisibility}}" AutomationProperties.AutomationId="TrialFailureNextStep" />

                    <!-- Immediate primary actions right on the result / recovery / preparation card -->
                    <WrapPanel Margin="0,14,0,0">
                        <ui:Button Content="取消准备" Appearance="Secondary" Padding="18,10" Margin="0,0,10,0" Click="OnCancelPreparation" IsEnabled="{Binding IsolatedTrial.CanCancelPreparation}" Visibility="{Binding IsolatedTrial.IsPreparingInput, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CancelTrialPreparationButton" />
                        <ui:Button Content="{Binding IsolatedTrial.EndTrialButtonText}" Appearance="Danger" Padding="18,10" Margin="0,0,10,0" Click="OnEndTrial" IsEnabled="{Binding IsolatedTrial.CanEndTrial}" Visibility="{Binding IsolatedTrial.IsSessionActive, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="EndIsolatedTrialButton">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Stop24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="重新检查" Appearance="Primary" Padding="18,10" Margin="0,0,10,0" Click="OnRecheckPendingSession" IsEnabled="{Binding IsolatedTrial.CanRecheckPendingSession}" Visibility="{Binding IsolatedTrial.CanRecheckPendingSession, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="RecheckPendingSessionButton">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="{Binding IsolatedTrial.RetryEndPendingButtonText}" Appearance="Secondary" Padding="16,10" Margin="0,0,10,0" Click="OnRetryEndPendingSession" IsEnabled="{Binding IsolatedTrial.CanRetryEndPendingSession}" Visibility="{Binding IsolatedTrial.CanRetryEndPendingSession, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="RetryEndPendingSessionButton" />
                        <ui:Button Content="重试清理" Appearance="Primary" Padding="18,10" Margin="0,0,10,0" Click="OnRetryStagingCleanup" IsEnabled="{Binding IsolatedTrial.CanRetryStagingCleanup}" Visibility="{Binding IsolatedTrial.CanRetryStagingCleanup, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="RetryStagingCleanupButton">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="再次试用" Appearance="Primary" Padding="20,10" Click="OnStartTrial" IsEnabled="{Binding IsolatedTrial.CanRetryTrial}" Visibility="{Binding IsolatedTrial.CanRetryTrial, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="RetryIsolatedTrialButton">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" /></ui:Button.Icon>
                        </ui:Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Capability blocked card with tailored non-destructive primary action -->
            <Border CornerRadius="10" Padding="20" Margin="0,0,0,16" Background="#FFF6F4" BorderBrush="#C86D5D" BorderThickness="1" Visibility="{Binding IsolatedTrial.IsCapabilityBlocked, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TrialCapabilityBlockedCard">
                <StackPanel>
                    <TextBlock Text="本机当前无法启动隔离沙箱（仍可查看文件/目录信息与使用其他功能）" FontSize="12" FontWeight="SemiBold" Foreground="#8F2D1E" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding IsolatedTrial.Capability.Headline}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.AutomationId="TrialCapabilityBlockedHeadline" />
                    <TextBlock Text="{Binding IsolatedTrial.Capability.Detail}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="TrialCapabilityBlockedDetail" />
                    <TextBlock Text="{Binding IsolatedTrial.CapabilityPermissionNote}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding IsolatedTrial.HasCapabilityPermissionNote, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TrialCapabilityPermissionNote" />
                    <TextBlock Text="{Binding IsolatedTrial.Capability.NextStep}" Style="{StaticResource MutedText}" TextWrapping="Wrap" AutomationProperties.AutomationId="TrialCapabilityNextStep" />

                    <WrapPanel Margin="0,14,0,0">
                        <ui:Button Content="打开 Windows 功能" Appearance="Primary" Padding="18,9" Margin="0,0,10,0" Click="OnOpenWindowsFeatures" Visibility="{Binding IsolatedTrial.ShowOpenWindowsFeaturesButton, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="OpenWindowsFeaturesButton">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="前往打包项目" Appearance="Primary" Padding="18,9" Margin="0,0,10,0" Click="OnGoToPackaging" Visibility="{Binding IsolatedTrial.ShowGoToPackagingButton, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="GoToPackagingFromTrialButton">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Box24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="重新检测" Appearance="Primary" Padding="18,9" Margin="0,0,10,0" Click="OnRecheckCapability" IsEnabled="{Binding IsolatedTrial.CanRecheckCapability}" Visibility="{Binding IsolatedTrial.ShowPrimaryRecheckButton, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="PrimaryRecheckCapabilityButton">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="重新检测" Appearance="Secondary" Padding="14,9" Click="OnRecheckCapability" IsEnabled="{Binding IsolatedTrial.CanRecheckCapability}" Visibility="{Binding IsolatedTrial.ShowOpenWindowsFeaturesButton, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="SecondaryRecheckCapabilityButton" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Unified target picker (Single EXE or Portable Software Folder) + Read-only inspection + Sandbox run -->
            <Border Style="{StaticResource Surface}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="1. 选择试用对象并查看本地信息（只读，不运行）" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding IsolatedTrial.SelectedTargetSummaryTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.AutomationId="SelectedTrialExeName" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <ui:Button Content="选择 EXE" Padding="16,10" Margin="0,0,8,0" Click="OnPickExe" IsEnabled="{Binding IsolatedTrial.CanSelectExecutable}" AutomationProperties.AutomationId="PickTrialExeButton">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="Document24" /></ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="选择软件文件夹" Padding="16,10" Click="OnPickFolder" IsEnabled="{Binding IsolatedTrial.CanSelectFolder}" AutomationProperties.AutomationId="PickTrialFolderButton">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <ui:TextBox Margin="0,12,0,0" Text="{Binding IsolatedTrial.ExecutablePathInput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsolatedTrial.CanSelectExecutable}" PlaceholderText="点击右上角“选择 EXE”或“选择软件文件夹”，也可直接粘贴本地 .exe 或目录路径" AutomationProperties.AutomationId="TrialExePathInput" AutomationProperties.Name="待查看或试用的本地程序或目录路径" />

                    <!-- Async folder scan progress -->
                    <Border Background="#EEF5FB" BorderBrush="#9BBAD8" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0" Visibility="{Binding IsolatedTrial.IsScanningFolder, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TrialFolderScanPanel">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding IsolatedTrial.FolderScanStatusText}" Foreground="#24527A" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="TrialFolderScanStatusText" />
                                <ui:Button Grid.Column="1" Content="取消扫描" Appearance="Secondary" Padding="12,5" Margin="12,0,0,0" Click="OnCancelFolderScan" IsEnabled="{Binding IsolatedTrial.CanCancelFolderScan}" AutomationProperties.AutomationId="CancelFolderScanButton" />
                            </Grid>
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="#FFF0ED" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" Visibility="{Binding IsolatedTrial.SelectionError, Converter={StaticResource TextVisibility}}">
                        <TextBlock Text="{Binding IsolatedTrial.SelectionError}" Foreground="#963D2E" TextWrapping="Wrap" AutomationProperties.AutomationId="TrialSelectionErrorText" />
                    </Border>

                    <!-- Folder mode scope & entry selector -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsolatedTrial.IsFolderSelected, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TrialFolderMetadataPanel">
                        <Border Background="#EEF5FB" BorderBrush="#9BBAD8" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding IsolatedTrial.FolderScopeHeadline}" Foreground="#1B466C" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="TrialFolderScopeHeadline" />
                                <TextBlock Text="{Binding IsolatedTrial.FolderScopeMetricsText}" Foreground="#24527A" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="TrialFolderScopeMetrics" />
                                <TextBlock Text="说明：开始试用时会先将该目录完整复制到本次专用暂存目录（不跟随链接或联接点），再只读映射给沙箱并复制到来宾可写目录运行；原目录保持不变。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Entry selector ("启动哪个程序") -->
                        <Border Background="#F7F9F9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0" Visibility="{Binding IsolatedTrial.HasRunnableFolderEntries, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TrialFolderEntryPanel">
                            <StackPanel>
                                <TextBlock Text="启动哪个程序" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding IsolatedTrial.FolderEntryPromptText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap" AutomationProperties.AutomationId="TrialFolderEntryPrompt" />
                                <ComboBox ItemsSource="{Binding IsolatedTrial.FolderEntryCandidates}"
                                          SelectedItem="{Binding IsolatedTrial.SelectedFolderEntry, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayLabel"
                                          IsEnabled="{Binding IsolatedTrial.CanSelectFolder}"
                                          AutomationProperties.AutomationId="TrialFolderEntrySelector"
                                          AutomationProperties.Name="选择要启动的入口程序" />
                            </StackPanel>
                        </Border>

                        <!-- No runnable entry warning -->
                        <Border Background="#FFF8EB" BorderBrush="#D99B26" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0" Visibility="{Binding IsolatedTrial.HasNoRunnableFolderEntries, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TrialFolderNoEntryWarning">
                            <TextBlock Text="{Binding IsolatedTrial.FolderNoEntryReasonText}" Foreground="#7A4F00" FontSize="13" TextWrapping="Wrap" AutomationProperties.AutomationId="TrialFolderNoEntryReasonText" />
                        </Border>
                    </StackPanel>

                    <!-- Read-only entry metadata & on-demand SHA-256 (works for single EXE or selected folder entry) -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsolatedTrial.HasExecutable, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TrialFileMetadataPanel">
                        <WrapPanel>
                            <TextBlock Text="{Binding IsolatedTrial.SelectedFolderEntryRelativePathText}" FontWeight="SemiBold" Foreground="#0E5A53" Margin="0,0,20,6" Visibility="{Binding IsolatedTrial.IsFolderSelected, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="SelectedTrialEntryRelPath" />
                            <TextBlock Text="{Binding IsolatedTrial.ExecutableSizeText}" FontWeight="SemiBold" Margin="0,0,20,6" AutomationProperties.AutomationId="SelectedTrialExeSize" />
                            <TextBlock Text="{Binding IsolatedTrial.ExecutableArchitectureText}" Style="{StaticResource MutedText}" Margin="0,0,20,6" AutomationProperties.AutomationId="SelectedTrialExeArch" />
                            <TextBlock Text="{Binding IsolatedTrial.ExecutableProductVersionText}" Style="{StaticResource MutedText}" Margin="0,0,0,6" AutomationProperties.AutomationId="SelectedTrialExeVersion" />
                        </WrapPanel>

                        <!-- On-demand async SHA-256 (explicitly labeled as entry file hash in folder mode) -->
                        <Border Background="#F7F9F9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,6,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IsolatedTrial.Sha256SectionTitle}" FontWeight="SemiBold" FontSize="13" AutomationProperties.AutomationId="TrialSha256Title" />
                                        <TextBlock Text="仅客观展示本地文件信息，不提供“安全/危险”评分，也不会在宿主机运行该文件。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" AutomationProperties.AutomationId="TrialNonVerdictNotice" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <ui:Button Content="{Binding IsolatedTrial.ComputeSha256ButtonText}" Padding="14,7" Click="OnComputeSha256" IsEnabled="{Binding IsolatedTrial.CanComputeSha256}" AutomationProperties.AutomationId="ComputeTrialSha256Button" />
                                        <ui:Button Content="复制 SHA-256" Appearance="Secondary" Padding="14,7" Margin="8,0,0,0" Click="OnCopySha256" IsEnabled="{Binding IsolatedTrial.CanCopySha256}" Visibility="{Binding IsolatedTrial.HasComputedSha256, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CopyTrialSha256Button">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24" /></ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsolatedTrial.IsComputingSha256, Converter={StaticResource BoolVisibility}}" />
                                <TextBox Text="{Binding IsolatedTrial.ComputedSha256, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Margin="0,8,0,0" Visibility="{Binding IsolatedTrial.HasComputedSha256, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TrialComputedSha256Value" AutomationProperties.Name="入口文件 SHA-256 值" />
                                <TextBlock Text="{Binding IsolatedTrial.HashErrorMessage}" Foreground="#963D2E" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding IsolatedTrial.HashErrorMessage, Converter={StaticResource TextVisibility}}" AutomationProperties.AutomationId="TrialHashErrorText" />
                            </StackPanel>
                        </Border>

                        <!-- Calm neutral note when sibling files exist (SingleFile mode only) -->
                        <Border Background="#F4F6F6" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,10,0,0" Visibility="{Binding IsolatedTrial.HasSiblingFilesNotice, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding IsolatedTrial.SiblingFilesNoticeText}" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" AutomationProperties.AutomationId="TrialSiblingFilesNotice" />
                        </Border>

                        <!-- Real warning ONLY when file cannot run in x64 Sandbox (e.g., ARM64) -->
                        <Border Background="#FFF8EB" BorderBrush="#D99B26" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" Visibility="{Binding IsolatedTrial.HasRunCompatibilityWarning, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding IsolatedTrial.RunCompatibilityWarningText}" Foreground="#7A4F00" FontSize="13" TextWrapping="Wrap" AutomationProperties.AutomationId="TrialRunCompatibilityWarning" />
                        </Border>
                    </StackPanel>

                    <!-- Section 2: Sandbox execution controls -->
                    <Border Background="#F4F8F7" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,16,0,0" AutomationProperties.AutomationId="TrialIsolationPolicyCard">
                        <StackPanel>
                            <TextBlock Text="2. 在沙箱中运行时的隔离边界" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,8">
                                <Border Background="#E4F1ED" CornerRadius="6" Padding="10,4" Margin="0,0,8,6">
                                    <TextBlock Text="关闭网络（离线沙箱）" Foreground="#0E5A53" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="#E4F1ED" CornerRadius="6" Padding="10,4" Margin="0,0,8,6">
                                    <TextBlock Text="关闭剪贴板共享" Foreground="#0E5A53" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="#E4F1ED" CornerRadius="6" Padding="10,4" Margin="0,0,8,6">
                                    <TextBlock Text="{Binding IsolatedTrial.IsolationMountBadgeText}" Foreground="#0E5A53" FontSize="12" FontWeight="SemiBold" AutomationProperties.AutomationId="TrialIsolationMountBadge" />
                                </Border>
                                <Border Background="#E4F1ED" CornerRadius="6" Padding="10,4" Margin="0,0,8,6">
                                    <TextBlock Text="关闭后丢弃来宾改动" Foreground="#0E5A53" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding IsolatedTrial.ScopeLimitationText}" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" AutomationProperties.AutomationId="TrialScopeLimitationText" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,16,0,0">
                        <ui:Button Content="开始隔离试用" Appearance="Primary" Padding="20,10" Margin="0,0,12,0" Click="OnStartTrial" IsEnabled="{Binding IsolatedTrial.CanStartTrial}" AutomationProperties.AutomationId="StartIsolatedTrialButton">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" /></ui:Button.Icon>
                        </ui:Button>
                        <TextBlock Text="{Binding IsolatedTrial.SandboxRunAvailabilityHint}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="{Binding IsolatedTrial.SandboxRunAvailabilityHint, Converter={StaticResource TextVisibility}}" AutomationProperties.AutomationId="TrialSandboxAvailabilityHint" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Collapsible technical details (holds UUID, PID, ExistingLogin, guest paths & full timeline) -->
            <Expander Header="查看技术详情与本次依据" IsExpanded="{Binding IsolatedTrial.TechnicalDetailsExpanded, Mode=TwoWay}" Margin="0,0,0,16" Visibility="{Binding IsolatedTrial.CanShowTechnicalDetails, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TrialTechnicalExpander">
                <Border Style="{StaticResource Surface}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="系统能力证据、实例 ID 与完整时间线" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1" Content="复制技术信息" Appearance="Transparent" Click="OnCopyTechnical" AutomationProperties.AutomationId="CopyTrialTechnicalButton" />
                        </Grid>
                        <TextBox Text="{Binding IsolatedTrial.TechnicalDetailsText, Mode=OneWay}" Style="{StaticResource SelectableText}" MaxHeight="320" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" AutomationProperties.AutomationId="TrialTechnicalText" AutomationProperties.Name="隔离试用技术详情" />
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
