<UserControl x:Class="Contain.Desktop.Views.PackageCheckView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:model="clr-namespace:Contain.Desktop.Model;assembly=Contain.Desktop.Model">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16,24,24">
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock Text="检查交付包" Style="{StaticResource PageTitle}" AutomationProperties.AutomationId="PackagePageTitle" />
            <TextBlock Text="选择收到的 Windows 软件压缩包（.zip），只读核对是否与交付清单一致及具体缺件（不启动包内程序）。" Style="{StaticResource MutedText}" Margin="0,0,0,20" AutomationProperties.AutomationId="PackagePurposeText" />

            <Border Style="{StaticResource Surface}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="待检查的软件压缩包" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding PackageCheck.ZipFileName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.AutomationId="SelectedPackageZipName" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="选择 ZIP 文件" Appearance="Primary" Padding="18,10" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnPickZip" IsEnabled="{Binding PackageCheck.CanPickZip}" AutomationProperties.AutomationId="PickPackageZip">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                    <ui:TextBox Margin="0,12,0,0" Text="{Binding PackageCheck.ZipPathInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="点击右侧“选择 ZIP 文件”，或直接粘贴本地 .zip 文件路径" AutomationProperties.AutomationId="PackageZipPathInput" AutomationProperties.Name="待检查的 ZIP 文件路径" />
                    <TextBlock Text="{Binding PackageCheck.SpecStatusLine}" Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="{Binding PackageCheck.SpecStatusLine, Converter={StaticResource TextVisibility}}" AutomationProperties.AutomationId="PackageSpecStatusLine" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Surface}" Visibility="{Binding PackageCheck.IsChecking, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding PackageCheck.CheckingBannerText}" TextWrapping="Wrap" AutomationProperties.AutomationId="PackageCheckingBanner" />
                </StackPanel>
            </Border>

            <Border CornerRadius="10" Padding="20" Margin="0,0,0,16" Background="#EEF5FB" BorderBrush="#4B7AA8" BorderThickness="1" Visibility="{Binding PackageCheck.IsMissingSpec, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock Text="需要选择校验清单" FontSize="12" FontWeight="SemiBold" Foreground="#2B5B84" Margin="0,0,0,6" AutomationProperties.AutomationId="MissingSpecBadge" />
                    <TextBlock Text="{Binding PackageCheck.Headline}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="MissingSpecHeadline" />
                    <TextBlock Text="{Binding PackageCheck.MissingSpecExplanation}" Style="{StaticResource MutedText}" TextWrapping="Wrap" AutomationProperties.AutomationId="MissingSpecExplanationText" />
                    <WrapPanel Margin="0,16,0,0">
                        <ui:Button Content="选择校验清单" Appearance="Primary" Click="OnPickSpec" IsEnabled="{Binding PackageCheck.CanPickSpec}" AutomationProperties.AutomationId="PickPackageSpec">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentText24" /></ui:Button.Icon>
                        </ui:Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="10" Padding="20" Margin="0,0,0,16" Background="#FFF0ED" BorderBrush="#B84A39" BorderThickness="1" Visibility="{Binding PackageCheck.IsCheckerOrSpecError, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="清单或校验程序出错" FontSize="12" FontWeight="SemiBold" Foreground="#8F2D1E" AutomationProperties.AutomationId="PackageCheckerErrorBadge" />
                        <TextBlock Grid.Column="1" Text="{Binding PackageCheck.CheckedTimeText}" Style="{StaticResource MutedText}" FontSize="12" Margin="12,0,0,0" Visibility="{Binding PackageCheck.CheckedTimeText, Converter={StaticResource TextVisibility}}" />
                    </Grid>
                    <TextBlock Text="{Binding PackageCheck.Headline}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="PackageErrorHeadline" />
                    <TextBlock Text="{Binding PackageCheck.SummaryNote}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding PackageCheck.ErrorDetail, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="#963D2E" Margin="0,12,0,0" Visibility="{Binding PackageCheck.ErrorDetail, Converter={StaticResource TextVisibility}}" AutomationProperties.AutomationId="PackageCheckerErrorDetail" AutomationProperties.Name="清单或检查器错误诊断" />
                    <WrapPanel Margin="0,16,0,0" Visibility="{Binding PackageCheck.HasZip, Converter={StaticResource BoolVisibility}}">
                        <ui:Button Content="{Binding PackageCheck.PickSpecButtonText}" Margin="0,0,10,0" Click="OnPickSpec" IsEnabled="{Binding PackageCheck.CanPickSpec}" AutomationProperties.AutomationId="ErrorPickSpecButton">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentText24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="重新检查" Appearance="Transparent" Click="OnRecheck" IsEnabled="{Binding PackageCheck.CanRecheck}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="10" Padding="20" Margin="0,0,0,16" BorderThickness="1" Visibility="{Binding PackageCheck.HasReportOutcome, Converter={StaticResource BoolVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PackageCheck.State}" Value="{x:Static model:PackageCheckState.Passed}">
                                <Setter Property="Background" Value="#EAF5F1" />
                                <Setter Property="BorderBrush" Value="#137D74" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PackageCheck.State}" Value="{x:Static model:PackageCheckState.Failed}">
                                <Setter Property="Background" Value="#FFF8EB" />
                                <Setter Property="BorderBrush" Value="#D99B26" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <WrapPanel VerticalAlignment="Center">
                            <Border CornerRadius="6" Padding="10,4" Margin="0,0,8,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#D4EFE7" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PackageCheck.State}" Value="{x:Static model:PackageCheckState.Failed}">
                                                <Setter Property="Background" Value="#FDE3DC" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PackageCheck.FileStatusBadge}" FontSize="12" FontWeight="SemiBold" AutomationProperties.AutomationId="PackageFileStatusBadge" />
                            </Border>
                            <Border Background="#E4EFF9" CornerRadius="6" Padding="10,4" Margin="0,0,8,4">
                                <TextBlock Text="{Binding PackageCheck.LaunchStatusBadge}" Foreground="#24527A" FontSize="12" FontWeight="SemiBold" AutomationProperties.AutomationId="PackageLaunchStatusBadge" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Grid.Column="1" Text="{Binding PackageCheck.CheckedTimeText}" Style="{StaticResource MutedText}" FontSize="12" Margin="12,2,0,0" VerticalAlignment="Top" AutomationProperties.AutomationId="PackageCheckedTime" />
                    </Grid>

                    <TextBlock Text="{Binding PackageCheck.Headline}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="PackageHeadline" />
                    <TextBlock Text="{Binding PackageCheck.SummaryNote}" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.AutomationId="PackageSummaryNote" />
                    <TextBlock Text="{Binding PackageCheck.LaunchStatusNote}" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" AutomationProperties.AutomationId="PackageLaunchStatusNote" />

                    <WrapPanel Margin="0,16,0,0">
                        <ui:Button Content="重新检查" Margin="0,0,10,0" Click="OnRecheck" IsEnabled="{Binding PackageCheck.CanRecheck}" AutomationProperties.AutomationId="RecheckPackageButton">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="更换校验清单" Click="OnPickSpec" IsEnabled="{Binding PackageCheck.CanPickSpec}" AutomationProperties.AutomationId="ChangePackageSpecButton">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentText24" /></ui:Button.Icon>
                        </ui:Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Surface}" Visibility="{Binding PackageCheck.ShowSpecPickerSurface, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock Text="指定或更换校验清单路径" Style="{StaticResource SectionTitle}" />
                    <ui:TextBox Text="{Binding PackageCheck.SpecPathInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="点击上方“选择/更换校验清单”，或直接粘贴本地 package-spec.json 路径" AutomationProperties.AutomationId="PackageSpecPathInput" AutomationProperties.Name="校验清单文件路径" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Surface}" Visibility="{Binding PackageCheck.HasVerifiedSummaryItems, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock Text="本次实际核对通过的项目" Style="{StaticResource SectionTitle}" AutomationProperties.AutomationId="PackageVerifiedTitle" />
                    <ItemsControl ItemsSource="{Binding PackageCheck.VerifiedSummaryItems}" AutomationProperties.AutomationId="PackageVerifiedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F2FAF6" BorderBrush="#137D74" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Mode=OneWay}" Foreground="#0E5A53" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Surface}" Visibility="{Binding PackageCheck.HasFailureItems, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock Text="发现的不一致与缺件原因" Style="{StaticResource SectionTitle}" AutomationProperties.AutomationId="PackageFailuresTitle" />
                    <ItemsControl ItemsSource="{Binding PackageCheck.FailureItems}" AutomationProperties.AutomationId="PackageFailuresList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFDFC" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Badge}" Foreground="#9A6400" FontWeight="SemiBold" FontSize="12" Margin="12,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Expander Header="查看详细哈希与技术信息" IsExpanded="{Binding PackageCheck.TechnicalDetailsExpanded, Mode=TwoWay}" Margin="0,0,0,16" Visibility="{Binding PackageCheck.CanShowTechnicalDetails, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="PackageTechnicalExpander">
                <Border Style="{StaticResource Surface}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="哈希摘要与结构化报告" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1" Content="复制技术信息" Appearance="Transparent" Click="OnCopyTechnical" AutomationProperties.AutomationId="CopyPackageTechnicalButton" />
                        </Grid>
                        <TextBox Text="{Binding PackageCheck.TechnicalDetailsText, Mode=OneWay}" Style="{StaticResource SelectableText}" MaxHeight="340" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" AutomationProperties.AutomationId="PackageTechnicalText" AutomationProperties.Name="交付包详细哈希与技术报告" />
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
