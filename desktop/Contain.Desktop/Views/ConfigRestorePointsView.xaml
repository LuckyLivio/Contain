<UserControl x:Class="Contain.Desktop.Views.ConfigRestorePointsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:model="clr-namespace:Contain.Desktop.Model;assembly=Contain.Desktop.Model">
    <Grid Margin="18,10,18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact Page Header -->
        <DockPanel Margin="0,0,0,8">
            <ui:Button DockPanel.Dock="Right" Content="导入还原点…" Appearance="Secondary" Padding="11,5.5" Margin="10,0,0,0" FontSize="12.5"
                       Click="OnOpenImportWorkspace" IsEnabled="{Binding ConfigRestorePoints.CanOpenImportWorkspace}"
                       ToolTip="打开从另一台电脑导出的 .contain-config-point 配置还原点迁移包，选择本机目标后预览差异再恢复。"
                       AutomationProperties.AutomationId="ImportRestorePointButton">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload24" /></ui:Button.Icon>
            </ui:Button>
            <TextBlock DockPanel.Dock="Left" Text="配置还原点" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"
                       AutomationProperties.AutomationId="ConfigRestorePointsPageTitle" />
            <TextBlock Text="单配置文件原始字节备份、逐行对比、跨电脑迁移、恢复与撤销预览（无需管理员权限或 Windows 沙盒）"
                       Style="{StaticResource MutedText}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       ToolTip="为单个本地配置文件保留原始字节备份，支持跨电脑导出/导入迁移、对比逐行差异后确认恢复并支持撤销预览（普通用户即可使用，无需管理员权限或 Windows 沙盒）。"
                       AutomationProperties.AutomationId="ConfigRestorePointsPurposeText" />
        </DockPanel>

        <!-- Compact Single-Line Create Restore Point Strip -->
        <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="10,7" Margin="0,0,0,10"
                Visibility="{Binding ConfigRestorePoints.ShowCreateCard, Converter={StaticResource BoolVisibility}}"
                AutomationProperties.AutomationId="ConfigCreateCard">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0"
                                Text="{Binding ConfigRestorePoints.TargetFilePathInput, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="NoWrap" MaxLines="1" VerticalContentAlignment="Center"
                                PlaceholderText="选择或粘贴配置文件路径（如 settings.json）"
                                AutomationProperties.AutomationId="ConfigFilePathInput"
                                AutomationProperties.Name="目标配置文件路径" />
                    <ui:Button Grid.Column="1" Content="选择文件" Padding="10,7" Margin="6,0,6,0" Click="OnPickConfigFile"
                               AutomationProperties.AutomationId="PickConfigFileButton">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Document24" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:TextBox Grid.Column="2"
                                Text="{Binding ConfigRestorePoints.NoteInput, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="NoWrap" MaxLines="1" VerticalContentAlignment="Center"
                                PlaceholderText="备注（如：改快捷键前）"
                                AutomationProperties.AutomationId="ConfigNoteInput"
                                AutomationProperties.Name="还原点备注" />
                    <ui:Button Grid.Column="3" Content="创建还原点" Appearance="Primary" Padding="12,7" Margin="6,0,0,0"
                               Click="OnCreateRestorePoint" IsEnabled="{Binding ConfigRestorePoints.CanCreateRestorePoint}"
                               AutomationProperties.AutomationId="CreateRestorePointButton">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" /></ui:Button.Icon>
                    </ui:Button>
                </Grid>

                <Border Background="#F2F8F6" BorderBrush="#CBE4DC" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,6,0,0"
                        Visibility="{Binding ConfigRestorePoints.HasCandidatePreview, Converter={StaticResource BoolVisibility}}"
                        AutomationProperties.AutomationId="ConfigCandidatePreviewBar">
                    <WrapPanel>
                        <TextBlock Text="{Binding ConfigRestorePoints.CandidateSummaryTitle}" FontWeight="SemiBold" Foreground="#0E5A53" FontSize="12" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding ConfigRestorePoints.CandidateSummaryMeta}" Style="{StaticResource MutedText}" FontSize="12" />
                    </WrapPanel>
                </Border>

                <Border Background="#FFF0ED" BorderBrush="#E5B6AC" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,6,0,0"
                        Visibility="{Binding ConfigRestorePoints.HasCandidateError, Converter={StaticResource BoolVisibility}}"
                        AutomationProperties.AutomationId="ConfigCandidateErrorBar">
                    <TextBlock Text="{Binding ConfigRestorePoints.CandidateErrorMessage}" Foreground="#963D2E" FontSize="12" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Main Two-Column Master-Detail Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Saved Restore Points List -->
            <Border Grid.Column="0" Style="{StaticResource Surface}" Padding="8" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="4,0,0,6">
                        <ui:Button DockPanel.Dock="Right" Content="刷新" Appearance="Transparent" Padding="6,3" FontSize="12" Click="OnRefreshList"
                                   AutomationProperties.AutomationId="RefreshRestorePointsButton">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                        </ui:Button>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14">
                            <Run Text="已保存还原点（" /><Run Text="{Binding ConfigRestorePoints.TotalCount, Mode=OneWay}" /><Run Text="）" />
                        </TextBlock>
                    </DockPanel>

                    <ui:TextBox Grid.Row="1" Margin="2,0,2,6" TextWrapping="NoWrap" MaxLines="1" FontSize="12.5"
                                Text="{Binding ConfigRestorePoints.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="按文件名、目录或备注筛选"
                                AutomationProperties.AutomationId="ConfigSearchBox"
                                AutomationProperties.Name="筛选配置还原点" />

                    <ListBox Grid.Row="2" x:Name="RestorePointsList"
                             ItemsSource="{Binding ConfigRestorePoints.FilteredPoints}"
                             SelectedItem="{Binding ConfigRestorePoints.SelectedPoint, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="RestorePointsList"
                             AutomationProperties.Name="配置还原点列表">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RecordItem}">
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="Margin" Value="0,1.5" />
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayScopedName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="#E4EFF9" CornerRadius="4" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayParentBadge}" Foreground="#1B466C" FontSize="10.5" FontWeight="SemiBold" MaxWidth="105" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </Border>
                                        <TextBlock Text="{Binding TargetFileName}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding DisplayNote}" Foreground="#0E5A53" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolVisibility}}" />
                                    <TextBlock Text="{Binding DisplayDirectory}" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding TargetPath}" />
                                    <TextBlock Text="{Binding DisplayListMeta}" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"
                                Visibility="{Binding ConfigRestorePoints.IsListEmpty, Converter={StaticResource BoolVisibility}}">
                        <ui:SymbolIcon Symbol="History24" FontSize="28" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="还没有配置还原点" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="在上方选择配置文件并点击「创建还原点」，即可保留原始字节副本。" Style="{StaticResource MutedText}" FontSize="12" TextAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"
                                Visibility="{Binding ConfigRestorePoints.IsSearchEmpty, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="没有匹配的还原点" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <ui:Button Content="清除筛选" Appearance="Secondary" Margin="0,8,0,0" HorizontalAlignment="Center" Click="OnClearSearch" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Column: Operation Banner, Undo Bar/Preview, Restore Preview, or Browse Detail -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Operation Result Banner (Create / Restore / Undo / Failure) -->
                    <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,8" BorderThickness="1"
                            Visibility="{Binding ConfigRestorePoints.HasOperationBanner, Converter={StaticResource BoolVisibility}}"
                            AutomationProperties.AutomationId="ConfigOperationBanner">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#EAF5F1" />
                                <Setter Property="BorderBrush" Value="#8DC4B7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConfigRestorePoints.IsOperationBannerWarning}" Value="True">
                                        <Setter Property="Background" Value="#FFF8EB" />
                                        <Setter Property="BorderBrush" Value="#D99B26" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConfigRestorePoints.IsOperationBannerError}" Value="True">
                                        <Setter Property="Background" Value="#FFF0ED" />
                                        <Setter Property="BorderBrush" Value="#C86D5D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding ConfigRestorePoints.OperationBannerHeadline}" FontWeight="SemiBold" FontSize="13.5"
                                       AutomationProperties.AutomationId="ConfigOperationBannerHeadline">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#0E5A53" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConfigRestorePoints.IsOperationBannerWarning}" Value="True">
                                                <Setter Property="Foreground" Value="#7A4300" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConfigRestorePoints.IsOperationBannerError}" Value="True">
                                                <Setter Property="Foreground" Value="#8F2D1E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ConfigRestorePoints.OperationBannerDetail}" FontSize="12" Margin="0,2,0,0"
                                       AutomationProperties.AutomationId="ConfigOperationBannerDetail" />
                        </StackPanel>
                    </Border>

                    <!-- PORTABLE RESTORE POINT IMPORT WORKSPACE ("导入还原点…" — offline, read-only preview -> confirm -> v0.7.0 restore & undo) -->
                    <StackPanel Visibility="{Binding ConfigRestorePoints.ShowImportPanel, Converter={StaticResource BoolVisibility}}"
                                AutomationProperties.AutomationId="ConfigImportPanel">
                        <!-- Step 1 & Step 2 Compact Setup Strip -->
                        <Border Style="{StaticResource Surface}" Padding="10,6" Margin="0,0,0,6"
                                AutomationProperties.AutomationId="ConfigImportSetupCard">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="迁移包：" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ui:TextBox Grid.Column="1" FontSize="12" Padding="8,4"
                                                Text="{Binding ConfigRestorePoints.ImportPackagePathInput, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="NoWrap" MaxLines="1" VerticalContentAlignment="Center"
                                                PlaceholderText="选择或粘贴 .contain-config-point 迁移包路径"
                                                AutomationProperties.AutomationId="ImportPackagePathInput"
                                                AutomationProperties.Name="配置还原点迁移包路径" />
                                    <ui:Button Grid.Column="2" Content="选择迁移包…" Appearance="Secondary" Padding="8,4.5" Margin="5,0,4,0" FontSize="11.5"
                                               Click="OnPickImportPackage" AutomationProperties.AutomationId="PickImportPackageButton">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Grid.Column="3" Content="关闭" Appearance="Transparent" Padding="7,4.5" FontSize="11.5"
                                               Click="OnCancelImport" AutomationProperties.AutomationId="CancelImportButton" />
                                </Grid>

                                <!-- Package Verified Summary (compact single/two-line strip for high DPI) -->
                                <Border Background="#EAF5F1" BorderBrush="#8DC4B7" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,4,0,0"
                                        Visibility="{Binding ConfigRestorePoints.HasValidImportedPackage, Converter={StaticResource BoolVisibility}}"
                                        AutomationProperties.AutomationId="ConfigImportPackageSummaryBar">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ConfigRestorePoints.ImportedPackageVerifiedHeadline}" Foreground="#0E5A53" FontWeight="SemiBold" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ConfigRestorePoints.ImportedPackageVerifiedHeadline}"
                                                   AutomationProperties.AutomationId="ConfigImportPackageHeadline" />
                                        <TextBlock Text="{Binding ConfigRestorePoints.ImportedPackageVerifiedMeta}" Style="{StaticResource MutedText}" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ConfigRestorePoints.ImportedPackageVerifiedMeta}"
                                                   AutomationProperties.AutomationId="ConfigImportPackageMeta" />
                                    </StackPanel>
                                </Border>

                                <!-- Package Validation Error -->
                                <Border Background="#FFF0ED" BorderBrush="#C86D5D" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,4,0,0"
                                        Visibility="{Binding ConfigRestorePoints.HasInvalidImportedPackage, Converter={StaticResource BoolVisibility}}"
                                        AutomationProperties.AutomationId="ConfigImportPackageErrorBar">
                                    <TextBlock Text="{Binding ConfigRestorePoints.ImportedPackageErrorMessage}" Foreground="#8F2D1E" FontWeight="SemiBold" FontSize="11.5" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="ConfigImportPackageErrorText" />
                                </Border>

                                <!-- Step 2: Select Target Path on Receiving Machine (shown only after package passes validation) -->
                                <StackPanel Margin="0,5,0,0"
                                            Visibility="{Binding ConfigRestorePoints.HasValidImportedPackage, Converter={StaticResource BoolVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="本机目标：" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ui:TextBox Grid.Column="1" FontSize="12" Padding="8,4"
                                                    Text="{Binding ConfigRestorePoints.ImportTargetPathInput, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="NoWrap" MaxLines="1" VerticalContentAlignment="Center"
                                                    PlaceholderText="选择或粘贴本机目标配置文件路径（已有文件或待新建路径）"
                                                    AutomationProperties.AutomationId="ImportTargetPathInput"
                                                    AutomationProperties.Name="本机目标配置文件路径" />
                                        <ui:Button Grid.Column="2" Content="选择目标…" Appearance="Secondary" Padding="8,4.5" Margin="5,0,4,0" FontSize="11.5"
                                                   Click="OnPickImportTarget" AutomationProperties.AutomationId="PickImportTargetButton">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Document24" /></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Grid.Column="3" Content="刷新" Appearance="Secondary" Padding="7,4.5" FontSize="11.5"
                                                   ToolTip="重新检查本机目标文件状态"
                                                   Click="OnRecheckImportTarget" AutomationProperties.AutomationId="RecheckImportTargetButton">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                                        </ui:Button>
                                    </Grid>

                                    <!-- Lightweight "如何找到配置文件？" toggle & collapsible VS Code tip -->
                                    <StackPanel Orientation="Horizontal" Margin="62,2.5,0,0">
                                        <ui:Button Content="{Binding ConfigRestorePoints.ImportTargetHelpToggleText}" Appearance="Transparent"
                                                   Padding="4,1.5" FontSize="11" Foreground="#0E5A53"
                                                   Click="OnToggleImportTargetHelp"
                                                   AutomationProperties.AutomationId="ToggleImportTargetHelpButton">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Info24" FontSize="12" /></ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>

                                    <Border Background="#F4F8FB" BorderBrush="#C4D6E7" BorderThickness="1" CornerRadius="5" Padding="9,6" Margin="0,3,0,0"
                                            Visibility="{Binding ConfigRestorePoints.ShowImportTargetHelp, Converter={StaticResource BoolVisibility}}"
                                            AutomationProperties.AutomationId="ConfigImportTargetHelpCard">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ConfigRestorePoints.ImportTargetHelpTitle}" Foreground="#173A5A" FontSize="11.5" FontWeight="SemiBold"
                                                       AutomationProperties.AutomationId="ConfigImportTargetHelpTitle" />
                                            <TextBlock Text="{Binding ConfigRestorePoints.ImportTargetHelpDetail}" Foreground="#2B4B69" FontSize="11" LineHeight="16" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       AutomationProperties.AutomationId="ConfigImportTargetHelpText" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Step 3: Import Restore Preview & Confirm Card (Target path + Direction + Confirm + Diff all above the fold at 150% DPI!) -->
                        <StackPanel Visibility="{Binding ConfigRestorePoints.HasImportPreview, Converter={StaticResource BoolVisibility}}">
                            <Border CornerRadius="9" Padding="11,7" Margin="0,0,0,6" BorderThickness="1.5"
                                    AutomationProperties.AutomationId="ConfigImportPreviewCard">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FFFBF2" />
                                        <Setter Property="BorderBrush" Value="#D99B26" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConfigRestorePoints.IsImportReadyToCreate}" Value="True">
                                                <Setter Property="Background" Value="#F2F8F6" />
                                                <Setter Property="BorderBrush" Value="#2E7D72" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConfigRestorePoints.IsImportIdentical}" Value="True">
                                                <Setter Property="Background" Value="#EAF5F1" />
                                                <Setter Property="BorderBrush" Value="#8DC4B7" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConfigRestorePoints.IsImportPreviewError}" Value="True">
                                                <Setter Property="Background" Value="#FFF6F4" />
                                                <Setter Property="BorderBrush" Value="#C86D5D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#FDE8C8" CornerRadius="4" Padding="6,1.5" Margin="0,0,5,0">
                                                <TextBlock Text="{Binding ConfigRestorePoints.ImportPreviewDirectionLabel}" Foreground="#7A4300" FontSize="11" FontWeight="SemiBold"
                                                           AutomationProperties.AutomationId="ConfigImportDirectionBadge" />
                                            </Border>
                                            <Border Background="#F3EBDD" CornerRadius="4" Padding="6,1.5">
                                                <TextBlock Text="尚未写入磁盘" Foreground="#6E4E1B" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ConfigRestorePoints.ImportPreviewTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#5C3100"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   AutomationProperties.AutomationId="ConfigImportPreviewTitle" />
                                    </DockPanel>

                                    <!-- Mid-confirmation external edit alert -->
                                    <Border Background="#FDE8C8" BorderBrush="#D99B26" BorderThickness="1" CornerRadius="5" Padding="7,3.5" Margin="0,0,0,4"
                                            Visibility="{Binding ConfigRestorePoints.HasImportMidConfirmWarning, Converter={StaticResource BoolVisibility}}"
                                            AutomationProperties.AutomationId="ConfigImportMidEditBanner">
                                        <TextBlock Text="{Binding ConfigRestorePoints.ImportMidConfirmWarningText}" Foreground="#7A4300" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="ConfigImportMidEditText" />
                                    </Border>

                                    <!-- Full Target Path (always readable at high DPI) -->
                                    <Border Background="White" BorderBrush="#E8CFA0" BorderThickness="1" CornerRadius="5" Padding="7,3" Margin="0,0,0,3">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="本机目标路径：" FontSize="11" FontWeight="SemiBold" Foreground="#8A4B00" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding ConfigRestorePoints.ImportPreviewTargetPath}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" AutomationProperties.AutomationId="ConfigImportTargetPath" />
                                        </DockPanel>
                                    </Border>

                                    <TextBlock Text="{Binding ConfigRestorePoints.ImportPreviewFormatTransition}" FontSize="11" Foreground="#4A2E0B"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ConfigRestorePoints.ImportPreviewFormatTransition}" Margin="0,0,0,1.5"
                                               AutomationProperties.AutomationId="ConfigImportFormatTransition" />
                                    <TextBlock Text="{Binding ConfigRestorePoints.ImportPreviewActionSummary}" FontSize="11" Foreground="#354643"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ConfigRestorePoints.ImportPreviewActionSummary}" Margin="0,0,0,5"
                                               AutomationProperties.AutomationId="ConfigImportActionSummary" />

                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="{Binding ConfigRestorePoints.ConfirmImportRestoreButtonText}" Padding="11,5" Margin="0,0,8,0" FontSize="12"
                                                   Click="OnConfirmImportRestore" IsEnabled="{Binding ConfigRestorePoints.CanConfirmImportRestore}"
                                                   AutomationProperties.AutomationId="ConfirmImportRestoreButton">
                                            <ui:Button.Style>
                                                <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Appearance" Value="Danger" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConfigRestorePoints.IsImportReadyToCreate}" Value="True">
                                                            <Setter Property="Appearance" Value="Primary" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Checkmark24" /></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="取消（不写入磁盘）" Appearance="Secondary" Padding="10,5" FontSize="12"
                                                   Click="OnCancelImport" AutomationProperties.AutomationId="CancelImportPreviewButton" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Directional Import Diff / Missing-Target Creation Card -->
                            <Border Style="{StaticResource Surface}" Padding="11,6" Margin="0" AutomationProperties.AutomationId="ConfigImportDiffCard">
                                <StackPanel>
                                    <TextBlock Text="{Binding ConfigRestorePoints.ImportDiffHeaderSummary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"
                                               AutomationProperties.AutomationId="ConfigImportDiffHeaderSummary" />

                                    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="5" Background="White"
                                            Visibility="{Binding ConfigRestorePoints.HasImportTextDiff, Converter={StaticResource BoolVisibility}}"
                                            AutomationProperties.AutomationId="ConfigImportDiffLinesContainer">
                                        <ItemsControl ItemsSource="{Binding ConfigRestorePoints.ImportDiffLines}" AutomationProperties.AutomationId="ConfigImportDiffLinesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="7,1.5" BorderBrush="#F0F3F2" BorderThickness="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="White" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Removed}">
                                                                        <Setter Property="Background" Value="#FFF0ED" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Added}">
                                                                        <Setter Property="Background" Value="#EAF5F1" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Ellipsis}">
                                                                        <Setter Property="Background" Value="#F4F6F6" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="74" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding LineNumbersDisplay}"
                                                                       FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"
                                                                       Foreground="#7A8C87" Margin="0,0,6,0" TextWrapping="NoWrap" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayLine}"
                                                                       FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#213934" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Removed}">
                                                                                <Setter Property="Foreground" Value="#8F2D1E" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Added}">
                                                                                <Setter Property="Foreground" Value="#0E5A53" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Ellipsis}">
                                                                                <Setter Property="Foreground" Value="#596D68" />
                                                                                <Setter Property="FontStyle" Value="Italic" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <TextBlock Text="{Binding ConfigRestorePoints.ImportDiffFallbackNote}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"
                                               Visibility="{Binding ConfigRestorePoints.HasImportDiffTruncationNote, Converter={StaticResource BoolVisibility}}" />

                                    <Border Background="#F7F9F9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="5" Padding="9,6"
                                            Visibility="{Binding ConfigRestorePoints.ShowImportDiffFallback, Converter={StaticResource BoolVisibility}}"
                                            AutomationProperties.AutomationId="ConfigImportDiffFallbackCard">
                                        <TextBlock Text="{Binding ConfigRestorePoints.ImportDiffFallbackNote}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="ConfigImportDiffFallbackText" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Interrupted Operation Reconciliation Card (read-only startup/refresh verdict; NEVER auto-writes target!) -->
                    <Border CornerRadius="10" Padding="13,9" Margin="0,0,0,9" BorderThickness="1.5"
                            Visibility="{Binding ConfigRestorePoints.ShowRecoveryCard, Converter={StaticResource BoolVisibility}}"
                            AutomationProperties.AutomationId="ConfigRecoveryCard">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#EAF5F1" />
                                <Setter Property="BorderBrush" Value="#5C9F8E" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConfigRestorePoints.IsRecoveryInfo}" Value="True">
                                        <Setter Property="Background" Value="#EEF5FC" />
                                        <Setter Property="BorderBrush" Value="#4B7AA8" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConfigRestorePoints.IsRecoveryWarning}" Value="True">
                                        <Setter Property="Background" Value="#FFF8EB" />
                                        <Setter Property="BorderBrush" Value="#D99B26" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#D6EDE5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsRecoveryInfo}" Value="True">
                                                    <Setter Property="Background" Value="#DCEAF7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsRecoveryWarning}" Value="True">
                                                    <Setter Property="Background" Value="#FDE8C8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ConfigRestorePoints.RecoveryStatusBadge}" FontSize="11" FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="ConfigRecoveryStatusBadge">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#0E5A53" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConfigRestorePoints.IsRecoveryInfo}" Value="True">
                                                        <Setter Property="Foreground" Value="#1B466C" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ConfigRestorePoints.IsRecoveryWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="#7A4300" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding ConfigRestorePoints.RecoveryHeadline}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="ConfigRecoveryHeadline">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#0E5A53" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsRecoveryInfo}" Value="True">
                                                    <Setter Property="Foreground" Value="#173A5A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsRecoveryWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="#5C3100" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>

                            <Border Background="White" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,5">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="核对目标：" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding ConfigRestorePoints.RecoveryTargetPath}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" FontWeight="SemiBold"
                                               TextWrapping="Wrap" AutomationProperties.AutomationId="ConfigRecoveryTargetPath" />
                                </DockPanel>
                            </Border>

                            <TextBlock Text="{Binding ConfigRestorePoints.RecoveryDetail}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Margin="0,0,0,4"
                                       AutomationProperties.AutomationId="ConfigRecoveryDetail" />
                            <TextBlock Text="{Binding ConfigRestorePoints.RecoveryDiskStateSummary}" FontSize="11.5" FontWeight="SemiBold" Foreground="#213934" TextWrapping="Wrap" Margin="0,0,0,2"
                                       AutomationProperties.AutomationId="ConfigRecoveryDiskState" />
                            <TextBlock Text="{Binding ConfigRestorePoints.RecoveryOriginalCopySummary}" FontSize="11.5" Foreground="#354643" TextWrapping="Wrap" Margin="0,0,0,7"
                                       AutomationProperties.AutomationId="ConfigRecoveryOriginalCopyState" />

                            <WrapPanel Orientation="Horizontal">
                                <ui:Button Content="预览并撤销恢复…" Appearance="Primary" Padding="11,5.5" Margin="0,0,6,4" FontSize="12"
                                           Click="OnUndoFromRecovery"
                                           Visibility="{Binding ConfigRestorePoints.CanUndoFromRecovery, Converter={StaticResource BoolVisibility}}"
                                           AutomationProperties.AutomationId="RecoveryUndoPreviewButton">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUndo24" /></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="查看原副本" Appearance="Secondary" Padding="10,5.5" Margin="0,0,6,4" FontSize="12"
                                           Click="OnViewOriginalCopy"
                                           Visibility="{Binding ConfigRestorePoints.CanViewOriginalCopyFromRecovery, Converter={StaticResource BoolVisibility}}"
                                           AutomationProperties.AutomationId="RecoveryViewOriginalCopyButton">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Eye24" /></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="另存原副本…" Appearance="Secondary" Padding="10,5.5" Margin="0,0,6,4" FontSize="12"
                                           Click="OnExportOriginalCopy"
                                           ToolTip="另存恢复覆盖前保存在本机的原副本（用于救回覆盖前版本，非跨电脑还原点迁移包）。"
                                           Visibility="{Binding ConfigRestorePoints.CanExportOriginalCopyFromRecovery, Converter={StaticResource BoolVisibility}}"
                                           AutomationProperties.AutomationId="RecoveryExportOriginalCopyButton">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" /></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="重新核对" Appearance="Secondary" Padding="10,5.5" Margin="0,0,6,4" FontSize="12"
                                           Click="OnRecheckRecovery"
                                           Visibility="{Binding ConfigRestorePoints.CanRecheckRecovery, Converter={StaticResource BoolVisibility}}"
                                           AutomationProperties.AutomationId="RecoveryRecheckButton">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="{Binding ConfigRestorePoints.DismissRecoveryButtonText}" Appearance="Transparent" Padding="10,5.5" Margin="0,0,0,4" FontSize="12"
                                           Click="OnDismissRecovery"
                                           AutomationProperties.AutomationId="RecoveryDismissButton" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Inline Original Copy Preview Panel ("查看原副本" + "另存原副本…") -->
                    <StackPanel Visibility="{Binding ConfigRestorePoints.IsViewingOriginalCopy, Converter={StaticResource BoolVisibility}}"
                                AutomationProperties.AutomationId="ConfigOriginalCopyPreviewPanel">
                        <Border Background="#F2F7F6" BorderBrush="#2E7D72" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <Border DockPanel.Dock="Right" Background="#D6EDE5" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock Text="覆盖前原副本（只读预览）" Foreground="#0E5A53" FontSize="11" FontWeight="SemiBold"
                                                   AutomationProperties.AutomationId="ConfigOriginalCopyBadge" />
                                    </Border>
                                    <TextBlock Text="{Binding ConfigRestorePoints.OriginalCopyPreviewTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#0E4A44"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               AutomationProperties.AutomationId="ConfigOriginalCopyTitle" />
                                </DockPanel>

                                <Border Background="White" BorderBrush="#BFDCD5" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,5">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="原目标路径：" FontSize="11.5" FontWeight="SemiBold" Foreground="#0E5A53" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding ConfigRestorePoints.OriginalCopyTargetPath}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" AutomationProperties.AutomationId="ConfigOriginalCopyTargetPath" />
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="{Binding ConfigRestorePoints.OriginalCopyMetaSummary}" FontSize="11.5" Foreground="#214E48" TextWrapping="Wrap" Margin="0,0,0,8"
                                           AutomationProperties.AutomationId="ConfigOriginalCopyMeta" />

                                <WrapPanel Orientation="Horizontal">
                                    <ui:Button Content="另存原副本…" Appearance="Primary" Padding="12,6" Margin="0,0,8,4" FontSize="12.5"
                                               Click="OnExportOriginalCopy" IsEnabled="{Binding ConfigRestorePoints.CanExportFromOriginalCopyPreview}"
                                               ToolTip="另存恢复覆盖前保存在本机的原副本（用于救回覆盖前版本，非跨电脑还原点迁移包）。"
                                               AutomationProperties.AutomationId="OriginalCopySaveAsButton">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="关闭预览" Appearance="Secondary" Padding="10,6" Margin="0,0,0,4" FontSize="12.5"
                                               Click="OnCloseOriginalCopyPreview"
                                               AutomationProperties.AutomationId="CloseOriginalCopyPreviewButton" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Surface}" Padding="14,9" Margin="0">
                            <StackPanel>
                                <TextBlock Text="原副本完整内容（已通过 SHA-256 完整性校验）" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Background="White"
                                        Visibility="{Binding ConfigRestorePoints.HasOriginalCopyText, Converter={StaticResource BoolVisibility}}">
                                    <ItemsControl ItemsSource="{Binding ConfigRestorePoints.OriginalCopyLines}" AutomationProperties.AutomationId="ConfigOriginalCopyLinesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,2.5" BorderBrush="#F0F3F2" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding LineNumberDisplay}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" Foreground="#7A8C87" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Foreground="#213934" TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <Border Background="#F7F9F9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8"
                                        Visibility="{Binding ConfigRestorePoints.ShowOriginalCopyFallback, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="{Binding ConfigRestorePoints.OriginalCopyFallbackNote}" Style="{StaticResource MutedText}" FontSize="12"
                                               AutomationProperties.AutomationId="ConfigOriginalCopyFallbackText" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Always-explicit Undo Bar (names ACTUAL undo target file + warns if user selected a different file!) -->
                    <Border Background="#EEF5FB" BorderBrush="#9BBAD8" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8"
                            Visibility="{Binding ConfigRestorePoints.ShowUndoBar, Converter={StaticResource BoolVisibility}}"
                            AutomationProperties.AutomationId="ConfigUndoBar">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConfigRestorePoints.UndoBarHeadline}" Foreground="#1B466C" FontWeight="SemiBold" FontSize="12.5"
                                               AutomationProperties.AutomationId="ConfigUndoBarHeadline" />
                                    <TextBlock Text="{Binding ConfigRestorePoints.UndoContextText}" Foreground="#24527A" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"
                                               AutomationProperties.AutomationId="ConfigUndoBarTargetPath" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Content="{Binding ConfigRestorePoints.UndoButtonText}" Appearance="Secondary" Padding="10,6" Margin="10,0,0,0" FontSize="12"
                                           Click="OnBeginUndoPreview" AutomationProperties.AutomationId="UndoRestoreButton">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUndo24" /></ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <Border Background="#FFF4E5" BorderBrush="#D99B26" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,6,0,0"
                                    Visibility="{Binding ConfigRestorePoints.IsUndoTargetDifferentFromSelected, Converter={StaticResource BoolVisibility}}"
                                    AutomationProperties.AutomationId="ConfigUndoCrossTargetBanner">
                                <TextBlock Text="{Binding ConfigRestorePoints.UndoCrossTargetNotice}" Foreground="#7A4300" FontSize="11.5" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="ConfigUndoCrossTargetNotice" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- LIGHTWEIGHT UNDO PREVIEW PANEL (Current -> After Undo, actual target path, conflict protection, Cancel does NOT consume undo!) -->
                    <StackPanel Visibility="{Binding ConfigRestorePoints.ShowUndoPreviewPanel, Converter={StaticResource BoolVisibility}}"
                                AutomationProperties.AutomationId="ConfigUndoPreviewPanel">
                        <Border CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderThickness="1.5"
                                AutomationProperties.AutomationId="ConfigUndoPreviewCard">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F0F6FC" />
                                    <Setter Property="BorderBrush" Value="#4B7AA8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConfigRestorePoints.IsUndoPreviewConflict}" Value="True">
                                            <Setter Property="Background" Value="#FFF6F4" />
                                            <Setter Property="BorderBrush" Value="#C86D5D" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConfigRestorePoints.IsUndoPreviewRemoveRecreated}" Value="True">
                                            <Setter Property="Background" Value="#FFFBF2" />
                                            <Setter Property="BorderBrush" Value="#D99B26" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#DCEAF7" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewDirectionLabel}" Foreground="#1B466C" FontSize="11" FontWeight="SemiBold"
                                                       AutomationProperties.AutomationId="ConfigUndoPreviewDirectionBadge" />
                                        </Border>
                                        <Border Background="#E8EEF3" CornerRadius="4" Padding="7,2">
                                            <TextBlock Text="尚未写入磁盘" Foreground="#354643" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewTitle}" FontSize="15.5" FontWeight="SemiBold" Foreground="#173A5A"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               AutomationProperties.AutomationId="ConfigUndoPreviewTitle" />
                                </DockPanel>

                                <!-- Cross-file disambiguation notice inside Undo Preview -->
                                <Border Background="#FFF4E5" BorderBrush="#D99B26" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                                        Visibility="{Binding ConfigRestorePoints.IsUndoTargetDifferentFromSelected, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="{Binding ConfigRestorePoints.UndoCrossTargetNotice}" Foreground="#7A4300" FontSize="11.5" FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="ConfigUndoPreviewCrossTargetText" />
                                </Border>

                                <!-- Actual target path (wraps cleanly so full path is always readable at high DPI!) -->
                                <Border Background="White" BorderBrush="#C4D6E7" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="0,0,0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="实际目标路径：" FontSize="11.5" FontWeight="SemiBold" Foreground="#1B466C" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewTargetPath}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" AutomationProperties.AutomationId="ConfigUndoPreviewTargetPath" />
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewHeadline}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"
                                           AutomationProperties.AutomationId="ConfigUndoPreviewHeadline">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#173A5A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsUndoPreviewConflict}" Value="True">
                                                    <Setter Property="Foreground" Value="#8F2D1E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsUndoPreviewRemoveRecreated}" Value="True">
                                                    <Setter Property="Foreground" Value="#7A4300" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewFormatTransition}" FontSize="11.5" Foreground="#24527A" Margin="0,0,0,3"
                                           AutomationProperties.AutomationId="ConfigUndoPreviewFormatTransition" />
                                <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewActionSummary}" FontSize="12" Foreground="#213934" LineHeight="18" Margin="0,0,0,8"
                                           AutomationProperties.AutomationId="ConfigUndoPreviewActionSummary" />

                                <WrapPanel Orientation="Horizontal">
                                    <ui:Button Content="{Binding ConfigRestorePoints.ConfirmUndoButtonText}" Appearance="Primary" Padding="12,6" Margin="0,0,8,4" FontSize="12.5"
                                               Click="OnConfirmUndoRestore" IsEnabled="{Binding ConfigRestorePoints.CanConfirmUndo}"
                                               AutomationProperties.AutomationId="ConfirmUndoButton">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUndo24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="查看原副本" Appearance="Secondary" Padding="10,6" Margin="0,0,8,4" FontSize="12.5"
                                               Click="OnViewOriginalCopy"
                                               Visibility="{Binding ConfigRestorePoints.CanViewOriginalCopyFromUndoPreview, Converter={StaticResource BoolVisibility}}"
                                               AutomationProperties.AutomationId="UndoConflictViewOriginalCopyButton">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Eye24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="另存原副本…" Appearance="Secondary" Padding="10,6" Margin="0,0,8,4" FontSize="12.5"
                                               Click="OnExportOriginalCopy"
                                               ToolTip="另存恢复覆盖前保存在本机的原副本（用于救回覆盖前版本，非跨电脑还原点迁移包）。"
                                               Visibility="{Binding ConfigRestorePoints.CanExportOriginalCopyFromUndoPreview, Converter={StaticResource BoolVisibility}}"
                                               AutomationProperties.AutomationId="UndoConflictExportOriginalCopyButton">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="取消（保留撤销记录）" Appearance="Secondary" Padding="10,6" Margin="0,0,0,4" FontSize="12.5" Click="OnCancelUndoPreview"
                                               AutomationProperties.AutomationId="CancelUndoPreviewButton" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Undo Preview Diff / Conflict Explanation Card -->
                        <Border Style="{StaticResource Surface}" Padding="14,9" Margin="0" AutomationProperties.AutomationId="ConfigUndoDiffCard">
                            <StackPanel>
                                <TextBlock Text="{Binding ConfigRestorePoints.UndoDiffHeaderSummary}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5"
                                           AutomationProperties.AutomationId="ConfigUndoDiffHeaderSummary" />
                                <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewDetail}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,6"
                                           Visibility="{Binding ConfigRestorePoints.ShowUndoDiffFallback, Converter={StaticResource BoolVisibility}}"
                                           AutomationProperties.AutomationId="ConfigUndoPreviewDetail" />

                                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Background="White"
                                        Visibility="{Binding ConfigRestorePoints.HasUndoTextDiff, Converter={StaticResource BoolVisibility}}">
                                    <ItemsControl ItemsSource="{Binding ConfigRestorePoints.UndoDiffLines}" AutomationProperties.AutomationId="ConfigUndoDiffLinesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,2.5" BorderBrush="#F0F3F2" BorderThickness="0,0,0,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="White" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Removed}">
                                                                    <Setter Property="Background" Value="#FFF0ED" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Added}">
                                                                    <Setter Property="Background" Value="#EAF5F1" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Ellipsis}">
                                                                    <Setter Property="Background" Value="#F4F6F6" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding LineNumbersDisplay}"
                                                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                                                                   Foreground="#7A8C87" Margin="0,0,8,0" TextWrapping="NoWrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayLine}"
                                                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#213934" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Removed}">
                                                                            <Setter Property="Foreground" Value="#8F2D1E" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Added}">
                                                                            <Setter Property="Foreground" Value="#0E5A53" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Ellipsis}">
                                                                            <Setter Property="Foreground" Value="#596D68" />
                                                                            <Setter Property="FontStyle" Value="Italic" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <TextBlock Text="{Binding ConfigRestorePoints.UndoDiffFallbackNote}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,5,0,0"
                                           Visibility="{Binding ConfigRestorePoints.HasUndoDiffTruncationNote, Converter={StaticResource BoolVisibility}}" />

                                <Border Background="#F7F9F9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8"
                                        Visibility="{Binding ConfigRestorePoints.ShowUndoDiffFallback, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="{Binding ConfigRestorePoints.UndoDiffFallbackNote}" Style="{StaticResource MutedText}" FontSize="12"
                                               AutomationProperties.AutomationId="ConfigUndoDiffFallbackText" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Empty selection hint -->
                    <Border Style="{StaticResource Surface}" Padding="24" Margin="0"
                            Visibility="{Binding ConfigRestorePoints.HasNoSelectedPoint, Converter={StaticResource BoolVisibility}}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="选择左侧还原点以核对当前状态" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="选中任意还原点后，将只读比对从备份到现在的变化；点击「恢复」会切换为「当前文件 → 恢复后」预览，确认后再写入。"
                                       Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Selected Restore Point Content (Browse or Restore Preview) -->
                    <StackPanel Visibility="{Binding ConfigRestorePoints.ShowSelectedPointPanels, Converter={StaticResource BoolVisibility}}">

                        <!-- TOP-PRIORITY Inline Restore Preview / Confirmation Panel ("当前文件 → 恢复后") -->
                        <Border Background="#FFFBF2" BorderBrush="#D99B26" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                                Visibility="{Binding ConfigRestorePoints.IsConfirmingRestore, Converter={StaticResource BoolVisibility}}"
                                AutomationProperties.AutomationId="ConfigRestoreConfirmCard">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#FDE8C8" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ConfigRestorePoints.ConfirmRestoreDirectionLabel}" Foreground="#7A4300" FontSize="11" FontWeight="SemiBold"
                                                       AutomationProperties.AutomationId="ConfigRestoreDirectionBadge" />
                                        </Border>
                                        <Border Background="#F3EBDD" CornerRadius="4" Padding="7,2">
                                            <TextBlock Text="尚未写入磁盘" Foreground="#6E4E1B" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConfigRestorePoints.ConfirmRestoreTitle}" FontSize="15.5" FontWeight="SemiBold" Foreground="#5C3100"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               AutomationProperties.AutomationId="ConfigRestoreConfirmTitle" />
                                </DockPanel>

                                <!-- Mid-confirmation external edit refresh alert -->
                                <Border Background="#FDE8C8" BorderBrush="#D99B26" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                                        Visibility="{Binding ConfigRestorePoints.HasMidConfirmWarning, Converter={StaticResource BoolVisibility}}"
                                        AutomationProperties.AutomationId="ConfigMidEditWarningBanner">
                                    <TextBlock Text="{Binding ConfigRestorePoints.MidConfirmWarningText}" Foreground="#7A4300" FontSize="12" FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="ConfigMidEditWarningText" />
                                </Border>

                                <!-- Full target path (wraps cleanly so full filename is always readable at high DPI!) -->
                                <Border Background="White" BorderBrush="#E8CFA0" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="0,0,0,5">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="目标路径：" FontSize="11.5" FontWeight="SemiBold" Foreground="#8A4B00" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding ConfigRestorePoints.ConfirmRestoreTargetPath}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" AutomationProperties.AutomationId="ConfigRestoreConfirmTargetPath" />
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="{Binding ConfigRestorePoints.ConfirmRestoreFormatTransition}" FontSize="11.5" Foreground="#6A3C06" Margin="0,0,0,3"
                                           AutomationProperties.AutomationId="ConfigRestoreFormatTransition" />
                                <TextBlock Text="{Binding ConfigRestorePoints.ConfirmRestoreOperationText}" FontSize="12" Foreground="#4A2E0B" LineHeight="17" Margin="0,0,0,8"
                                           AutomationProperties.AutomationId="ConfigRestoreConfirmOperationText" />

                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="确认恢复（覆盖并保留撤销副本）" Appearance="Danger" Padding="14,7" Margin="0,0,8,0"
                                               Click="OnConfirmRestore" IsEnabled="{Binding ConfigRestorePoints.CanConfirmRestore}"
                                               AutomationProperties.AutomationId="ConfirmRestoreButton">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Checkmark24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="取消" Appearance="Secondary" Padding="12,7" Click="OnCancelRestore"
                                               AutomationProperties.AutomationId="CancelRestoreButton" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Inline Export Portable Restore Point Card ("导出还原点…" — saved backup A + privacy reminder) -->
                        <Border Background="#F2F8F6" BorderBrush="#2E7D72" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                                Visibility="{Binding ConfigRestorePoints.ShowExportPackageCard, Converter={StaticResource BoolVisibility}}"
                                AutomationProperties.AutomationId="ConfigExportPackageCard">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <Border DockPanel.Dock="Right" Background="#D6EDE5" CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="还原点保存的备份 · 不含源机路径" Foreground="#0E5A53" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding ConfigRestorePoints.ExportPackageTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#0E4A44"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               AutomationProperties.AutomationId="ConfigExportPackageTitle" />
                                </DockPanel>

                                <Border Background="White" BorderBrush="#BFDCD5" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding ConfigRestorePoints.ExportPackageVersionSummary}" FontSize="11.5" Foreground="#214E48" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="ConfigExportVersionSummary" />
                                </Border>

                                <!-- Privacy Reminder -->
                                <Border Background="#FFF8EB" BorderBrush="#D99B26" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,8"
                                        AutomationProperties.AutomationId="ConfigExportPrivacyNoticeCard">
                                    <TextBlock Text="{Binding ConfigRestorePoints.ExportPackagePrivacyNotice}" Foreground="#7A4300" FontSize="11.5" LineHeight="16" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="ConfigExportPrivacyNotice" />
                                </Border>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0"
                                                Text="{Binding ConfigRestorePoints.ExportPackagePathInput, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="NoWrap" MaxLines="1" VerticalContentAlignment="Center"
                                                PlaceholderText="选择或粘贴迁移包保存路径（.contain-config-point）"
                                                AutomationProperties.AutomationId="ExportPackagePathInput"
                                                AutomationProperties.Name="导出迁移包保存路径" />
                                    <ui:Button Grid.Column="1" Content="选择保存位置…" Appearance="Secondary" Padding="10,6" Margin="6,0,0,0" FontSize="12"
                                               Click="OnPickExportPackagePath" AutomationProperties.AutomationId="PickExportPackagePathButton">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="确认导出迁移包" Appearance="Primary" Padding="13,6.5" Margin="0,0,8,0"
                                               Click="OnConfirmExportRestorePoint" IsEnabled="{Binding ConfigRestorePoints.CanConfirmExportPackage}"
                                               AutomationProperties.AutomationId="ConfirmExportPackageButton">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUpload24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="取消" Appearance="Secondary" Padding="11,6.5" Click="OnCancelExportRestorePoint"
                                               AutomationProperties.AutomationId="CancelExportPackageButton" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Normal Browse Detail Header Card (hidden while confirming restore so Confirm + Diff stay above the fold!) -->
                        <Border Style="{StaticResource Surface}" Padding="14,10" Margin="0,0,0,10"
                                Visibility="{Binding ConfigRestorePoints.ShowDetailHeaderCard, Converter={StaticResource BoolVisibility}}"
                                AutomationProperties.AutomationId="ConfigDetailHeaderCard">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Left" CornerRadius="5" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EAF5F1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ConfigRestorePoints.IsStatusChanged}" Value="True">
                                                                <Setter Property="Background" Value="#FFF0D6" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConfigRestorePoints.IsStatusMissing}" Value="True">
                                                                <Setter Property="Background" Value="#FFF0D6" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConfigRestorePoints.IsStatusError}" Value="True">
                                                                <Setter Property="Background" Value="#FDE3DC" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ConfigRestorePoints.ComparisonStatusBadge}" FontSize="11.5" FontWeight="SemiBold"
                                                           AutomationProperties.AutomationId="ConfigComparisonStatusBadge">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0E5A53" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsStatusChanged}" Value="True">
                                                                    <Setter Property="Foreground" Value="#8A4B00" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsStatusMissing}" Value="True">
                                                                    <Setter Property="Foreground" Value="#8A4B00" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsStatusError}" Value="True">
                                                                    <Setter Property="Foreground" Value="#8F2D1E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding ConfigRestorePoints.SelectedScopedName}" FontSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ConfigRestorePoints.SelectedTargetPath}"
                                                       VerticalAlignment="Center"
                                                       AutomationProperties.AutomationId="ConfigSelectedScopedName" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                            <Run Text="备注：" /><Run Text="{Binding ConfigRestorePoints.SelectedNoteText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · 创建于 " /><Run Text="{Binding ConfigRestorePoints.SelectedCreatedTime, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <ui:Button Content="重新检查" Appearance="Secondary" Padding="9,6" Margin="0,0,6,0" Click="OnRecheckComparison"
                                                   AutomationProperties.AutomationId="RecheckConfigComparisonButton">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="导出还原点…" Appearance="Secondary" Padding="9,6" Margin="0,0,6,0" Click="OnBeginExportRestorePoint"
                                                   IsEnabled="{Binding ConfigRestorePoints.CanBeginExportRestorePoint}"
                                                   ToolTip="导出此还原点建点时保存的原始字节备份（.contain-config-point 迁移包，用于跨电脑迁移）；与恢复冲突时的「另存原副本…」不同。"
                                                   AutomationProperties.AutomationId="BeginExportRestorePointButton">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUpload24" /></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="恢复" Appearance="Primary" Padding="13,6" Click="OnBeginRestore"
                                                   IsEnabled="{Binding ConfigRestorePoints.CanBeginRestore}"
                                                   AutomationProperties.AutomationId="BeginRestoreButton">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowReset24" /></ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#F4F7F6" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,6,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="目标文件：" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" />
                                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding ConfigRestorePoints.SelectedTargetPath, Mode=OneWay}"
                                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" VerticalAlignment="Center"
                                                 AutomationProperties.AutomationId="ConfigSelectedTargetPath" />
                                    </DockPanel>
                                </Border>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F7FAF9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                        <StackPanel>
                                            <TextBlock Text="还原点备份（原始字节）" FontSize="11" FontWeight="SemiBold" Foreground="#0E5A53" />
                                            <TextBlock FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <Run Text="{Binding ConfigRestorePoints.BackupSizeText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding ConfigRestorePoints.BackupFormatText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding ConfigRestorePoints.BackupSha256Text}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ConfigRestorePoints.BackupSha256Text}" Margin="0,1,0,0" AutomationProperties.AutomationId="ConfigBackupSha256" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#F9F9FA" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                        <StackPanel>
                                            <TextBlock Text="当前目标文件" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <Run Text="{Binding ConfigRestorePoints.LiveSizeText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding ConfigRestorePoints.LiveFormatText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding ConfigRestorePoints.LiveSha256Text}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ConfigRestorePoints.LiveSha256Text}" Margin="0,1,0,0" AutomationProperties.AutomationId="ConfigLiveSha256" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Directional Line-by-Line Diff Card (Browse: 从备份到现在 | Restore Preview: 当前文件 → 恢复后) -->
                        <Border Style="{StaticResource Surface}" Padding="14,9" Margin="0" AutomationProperties.AutomationId="ConfigDiffCard">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="7,1.5" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EEF2F2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConfigRestorePoints.IsConfirmingRestore}" Value="True">
                                                        <Setter Property="Background" Value="#FDE8C8" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ConfigRestorePoints.DiffDirectionBadgeText}" FontSize="11" FontWeight="SemiBold"
                                                   AutomationProperties.AutomationId="ConfigDiffDirectionBadge">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#354643" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConfigRestorePoints.IsConfirmingRestore}" Value="True">
                                                            <Setter Property="Foreground" Value="#7A4300" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding ConfigRestorePoints.DiffHeaderSummary}" FontWeight="SemiBold" FontSize="13"
                                               AutomationProperties.AutomationId="ConfigDiffHeaderSummary" />
                                </DockPanel>
                                <TextBlock Text="{Binding ConfigRestorePoints.ComparisonDetail}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,6"
                                           Visibility="{Binding ConfigRestorePoints.IsNotConfirmingRestore, Converter={StaticResource BoolVisibility}}"
                                           AutomationProperties.AutomationId="ConfigComparisonDetail" />

                                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Background="White"
                                        Visibility="{Binding ConfigRestorePoints.HasTextDiff, Converter={StaticResource BoolVisibility}}"
                                        AutomationProperties.AutomationId="ConfigDiffLinesContainer">
                                    <ItemsControl ItemsSource="{Binding ConfigRestorePoints.DiffLines}" AutomationProperties.AutomationId="ConfigDiffLinesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,2.5" BorderBrush="#F0F3F2" BorderThickness="0,0,0,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="White" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Removed}">
                                                                    <Setter Property="Background" Value="#FFF0ED" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Added}">
                                                                    <Setter Property="Background" Value="#EAF5F1" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Ellipsis}">
                                                                    <Setter Property="Background" Value="#F4F6F6" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding LineNumbersDisplay}"
                                                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                                                                   Foreground="#7A8C87" Margin="0,0,8,0" TextWrapping="NoWrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayLine}"
                                                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#213934" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Removed}">
                                                                            <Setter Property="Foreground" Value="#8F2D1E" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Added}">
                                                                            <Setter Property="Foreground" Value="#0E5A53" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Ellipsis}">
                                                                            <Setter Property="Foreground" Value="#596D68" />
                                                                            <Setter Property="FontStyle" Value="Italic" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <TextBlock Text="{Binding ConfigRestorePoints.DiffFallbackNote}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,5,0,0"
                                           Visibility="{Binding ConfigRestorePoints.HasDiffTruncationNote, Converter={StaticResource BoolVisibility}}" />

                                <Border Background="#F7F9F9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8"
                                        Visibility="{Binding ConfigRestorePoints.ShowDiffFallback, Converter={StaticResource BoolVisibility}}"
                                        AutomationProperties.AutomationId="ConfigDiffFallbackCard">
                                    <TextBlock Text="{Binding ConfigRestorePoints.DiffFallbackNote}" Style="{StaticResource MutedText}" FontSize="12"
                                               AutomationProperties.AutomationId="ConfigDiffFallbackText" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
