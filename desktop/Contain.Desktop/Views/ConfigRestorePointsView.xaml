<UserControl x:Class="Contain.Desktop.Views.ConfigRestorePointsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:model="clr-namespace:Contain.Desktop.Model;assembly=Contain.Desktop.Model">
    <Grid Margin="18,10,18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact Page Header -->
        <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="配置还原点" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"
                       AutomationProperties.AutomationId="ConfigRestorePointsPageTitle" />
            <TextBlock Text="单配置文件原始字节备份、逐行对比、恢复与撤销预览（无需管理员权限或 Windows 沙盒）"
                       Style="{StaticResource MutedText}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       ToolTip="为单个本地配置文件保留原始字节备份，对比逐行差异后确认恢复并支持撤销预览（普通用户即可使用，无需管理员权限或 Windows 沙盒）。"
                       AutomationProperties.AutomationId="ConfigRestorePointsPurposeText" />
        </DockPanel>

        <!-- Compact Single-Line Create Restore Point Strip -->
        <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="10,7" Margin="0,0,0,10" AutomationProperties.AutomationId="ConfigCreateCard">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0"
                                Text="{Binding ConfigRestorePoints.TargetFilePathInput, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="NoWrap" MaxLines="1" VerticalContentAlignment="Center"
                                PlaceholderText="选择或粘贴配置文件路径（如 settings.json）"
                                AutomationProperties.AutomationId="ConfigFilePathInput"
                                AutomationProperties.Name="目标配置文件路径" />
                    <ui:Button Grid.Column="1" Content="选择文件" Padding="10,7" Margin="6,0,6,0" Click="OnPickConfigFile"
                               AutomationProperties.AutomationId="PickConfigFileButton">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Document24" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:TextBox Grid.Column="2"
                                Text="{Binding ConfigRestorePoints.NoteInput, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="NoWrap" MaxLines="1" VerticalContentAlignment="Center"
                                PlaceholderText="备注（如：改快捷键前）"
                                AutomationProperties.AutomationId="ConfigNoteInput"
                                AutomationProperties.Name="还原点备注" />
                    <ui:Button Grid.Column="3" Content="创建还原点" Appearance="Primary" Padding="12,7" Margin="6,0,0,0"
                               Click="OnCreateRestorePoint" IsEnabled="{Binding ConfigRestorePoints.CanCreateRestorePoint}"
                               AutomationProperties.AutomationId="CreateRestorePointButton">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" /></ui:Button.Icon>
                    </ui:Button>
                </Grid>

                <Border Background="#F2F8F6" BorderBrush="#CBE4DC" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,6,0,0"
                        Visibility="{Binding ConfigRestorePoints.HasCandidatePreview, Converter={StaticResource BoolVisibility}}"
                        AutomationProperties.AutomationId="ConfigCandidatePreviewBar">
                    <WrapPanel>
                        <TextBlock Text="{Binding ConfigRestorePoints.CandidateSummaryTitle}" FontWeight="SemiBold" Foreground="#0E5A53" FontSize="12" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding ConfigRestorePoints.CandidateSummaryMeta}" Style="{StaticResource MutedText}" FontSize="12" />
                    </WrapPanel>
                </Border>

                <Border Background="#FFF0ED" BorderBrush="#E5B6AC" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,6,0,0"
                        Visibility="{Binding ConfigRestorePoints.HasCandidateError, Converter={StaticResource BoolVisibility}}"
                        AutomationProperties.AutomationId="ConfigCandidateErrorBar">
                    <TextBlock Text="{Binding ConfigRestorePoints.CandidateErrorMessage}" Foreground="#963D2E" FontSize="12" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Main Two-Column Master-Detail Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Saved Restore Points List -->
            <Border Grid.Column="0" Style="{StaticResource Surface}" Padding="8" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="4,0,0,6">
                        <ui:Button DockPanel.Dock="Right" Content="刷新" Appearance="Transparent" Padding="6,3" FontSize="12" Click="OnRefreshList"
                                   AutomationProperties.AutomationId="RefreshRestorePointsButton">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                        </ui:Button>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14">
                            <Run Text="已保存还原点（" /><Run Text="{Binding ConfigRestorePoints.TotalCount, Mode=OneWay}" /><Run Text="）" />
                        </TextBlock>
                    </DockPanel>

                    <ui:TextBox Grid.Row="1" Margin="2,0,2,6" TextWrapping="NoWrap" MaxLines="1" FontSize="12.5"
                                Text="{Binding ConfigRestorePoints.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="按文件名、目录或备注筛选"
                                AutomationProperties.AutomationId="ConfigSearchBox"
                                AutomationProperties.Name="筛选配置还原点" />

                    <ListBox Grid.Row="2" x:Name="RestorePointsList"
                             ItemsSource="{Binding ConfigRestorePoints.FilteredPoints}"
                             SelectedItem="{Binding ConfigRestorePoints.SelectedPoint, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="RestorePointsList"
                             AutomationProperties.Name="配置还原点列表">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RecordItem}">
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="Margin" Value="0,1.5" />
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayScopedName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="#E4EFF9" CornerRadius="4" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayParentBadge}" Foreground="#1B466C" FontSize="10.5" FontWeight="SemiBold" MaxWidth="105" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </Border>
                                        <TextBlock Text="{Binding TargetFileName}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding DisplayNote}" Foreground="#0E5A53" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolVisibility}}" />
                                    <TextBlock Text="{Binding DisplayDirectory}" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding TargetPath}" />
                                    <TextBlock Text="{Binding DisplayListMeta}" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"
                                Visibility="{Binding ConfigRestorePoints.IsListEmpty, Converter={StaticResource BoolVisibility}}">
                        <ui:SymbolIcon Symbol="History24" FontSize="28" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="还没有配置还原点" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="在上方选择配置文件并点击「创建还原点」，即可保留原始字节副本。" Style="{StaticResource MutedText}" FontSize="12" TextAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"
                                Visibility="{Binding ConfigRestorePoints.IsSearchEmpty, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="没有匹配的还原点" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <ui:Button Content="清除筛选" Appearance="Secondary" Margin="0,8,0,0" HorizontalAlignment="Center" Click="OnClearSearch" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Column: Operation Banner, Undo Bar/Preview, Restore Preview, or Browse Detail -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Operation Result Banner (Create / Restore / Undo / Failure) -->
                    <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,8" BorderThickness="1"
                            Visibility="{Binding ConfigRestorePoints.HasOperationBanner, Converter={StaticResource BoolVisibility}}"
                            AutomationProperties.AutomationId="ConfigOperationBanner">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#EAF5F1" />
                                <Setter Property="BorderBrush" Value="#8DC4B7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConfigRestorePoints.IsOperationBannerWarning}" Value="True">
                                        <Setter Property="Background" Value="#FFF8EB" />
                                        <Setter Property="BorderBrush" Value="#D99B26" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConfigRestorePoints.IsOperationBannerError}" Value="True">
                                        <Setter Property="Background" Value="#FFF0ED" />
                                        <Setter Property="BorderBrush" Value="#C86D5D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding ConfigRestorePoints.OperationBannerHeadline}" FontWeight="SemiBold" FontSize="13.5"
                                       AutomationProperties.AutomationId="ConfigOperationBannerHeadline">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#0E5A53" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConfigRestorePoints.IsOperationBannerWarning}" Value="True">
                                                <Setter Property="Foreground" Value="#7A4300" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConfigRestorePoints.IsOperationBannerError}" Value="True">
                                                <Setter Property="Foreground" Value="#8F2D1E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ConfigRestorePoints.OperationBannerDetail}" FontSize="12" Margin="0,2,0,0"
                                       AutomationProperties.AutomationId="ConfigOperationBannerDetail" />
                        </StackPanel>
                    </Border>

                    <!-- Always-explicit Undo Bar (names ACTUAL undo target file + warns if user selected a different file!) -->
                    <Border Background="#EEF5FB" BorderBrush="#9BBAD8" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8"
                            Visibility="{Binding ConfigRestorePoints.ShowUndoBar, Converter={StaticResource BoolVisibility}}"
                            AutomationProperties.AutomationId="ConfigUndoBar">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConfigRestorePoints.UndoBarHeadline}" Foreground="#1B466C" FontWeight="SemiBold" FontSize="12.5"
                                               AutomationProperties.AutomationId="ConfigUndoBarHeadline" />
                                    <TextBlock Text="{Binding ConfigRestorePoints.UndoContextText}" Foreground="#24527A" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"
                                               AutomationProperties.AutomationId="ConfigUndoBarTargetPath" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Content="{Binding ConfigRestorePoints.UndoButtonText}" Appearance="Secondary" Padding="10,6" Margin="10,0,0,0" FontSize="12"
                                           Click="OnBeginUndoPreview" AutomationProperties.AutomationId="UndoRestoreButton">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUndo24" /></ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <Border Background="#FFF4E5" BorderBrush="#D99B26" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,6,0,0"
                                    Visibility="{Binding ConfigRestorePoints.IsUndoTargetDifferentFromSelected, Converter={StaticResource BoolVisibility}}"
                                    AutomationProperties.AutomationId="ConfigUndoCrossTargetBanner">
                                <TextBlock Text="{Binding ConfigRestorePoints.UndoCrossTargetNotice}" Foreground="#7A4300" FontSize="11.5" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="ConfigUndoCrossTargetNotice" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- LIGHTWEIGHT UNDO PREVIEW PANEL (Current -> After Undo, actual target path, conflict protection, Cancel does NOT consume undo!) -->
                    <StackPanel Visibility="{Binding ConfigRestorePoints.IsPreviewingUndo, Converter={StaticResource BoolVisibility}}"
                                AutomationProperties.AutomationId="ConfigUndoPreviewPanel">
                        <Border CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderThickness="1.5"
                                AutomationProperties.AutomationId="ConfigUndoPreviewCard">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F0F6FC" />
                                    <Setter Property="BorderBrush" Value="#4B7AA8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConfigRestorePoints.IsUndoPreviewConflict}" Value="True">
                                            <Setter Property="Background" Value="#FFF6F4" />
                                            <Setter Property="BorderBrush" Value="#C86D5D" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConfigRestorePoints.IsUndoPreviewRemoveRecreated}" Value="True">
                                            <Setter Property="Background" Value="#FFFBF2" />
                                            <Setter Property="BorderBrush" Value="#D99B26" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#DCEAF7" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewDirectionLabel}" Foreground="#1B466C" FontSize="11" FontWeight="SemiBold"
                                                       AutomationProperties.AutomationId="ConfigUndoPreviewDirectionBadge" />
                                        </Border>
                                        <Border Background="#E8EEF3" CornerRadius="4" Padding="7,2">
                                            <TextBlock Text="尚未写入磁盘" Foreground="#354643" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewTitle}" FontSize="15.5" FontWeight="SemiBold" Foreground="#173A5A"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               AutomationProperties.AutomationId="ConfigUndoPreviewTitle" />
                                </DockPanel>

                                <!-- Cross-file disambiguation notice inside Undo Preview -->
                                <Border Background="#FFF4E5" BorderBrush="#D99B26" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                                        Visibility="{Binding ConfigRestorePoints.IsUndoTargetDifferentFromSelected, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="{Binding ConfigRestorePoints.UndoCrossTargetNotice}" Foreground="#7A4300" FontSize="11.5" FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="ConfigUndoPreviewCrossTargetText" />
                                </Border>

                                <!-- Actual target path (wraps cleanly so full path is always readable at high DPI!) -->
                                <Border Background="White" BorderBrush="#C4D6E7" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="0,0,0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="实际目标路径：" FontSize="11.5" FontWeight="SemiBold" Foreground="#1B466C" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewTargetPath}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" AutomationProperties.AutomationId="ConfigUndoPreviewTargetPath" />
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewHeadline}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"
                                           AutomationProperties.AutomationId="ConfigUndoPreviewHeadline">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#173A5A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsUndoPreviewConflict}" Value="True">
                                                    <Setter Property="Foreground" Value="#8F2D1E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsUndoPreviewRemoveRecreated}" Value="True">
                                                    <Setter Property="Foreground" Value="#7A4300" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewFormatTransition}" FontSize="11.5" Foreground="#24527A" Margin="0,0,0,3"
                                           AutomationProperties.AutomationId="ConfigUndoPreviewFormatTransition" />
                                <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewActionSummary}" FontSize="12" Foreground="#213934" LineHeight="18" Margin="0,0,0,8"
                                           AutomationProperties.AutomationId="ConfigUndoPreviewActionSummary" />

                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="{Binding ConfigRestorePoints.ConfirmUndoButtonText}" Appearance="Primary" Padding="14,7" Margin="0,0,8,0"
                                               Click="OnConfirmUndoRestore" IsEnabled="{Binding ConfigRestorePoints.CanConfirmUndo}"
                                               AutomationProperties.AutomationId="ConfirmUndoButton">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUndo24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="取消（不写盘，保留撤销记录）" Appearance="Secondary" Padding="12,7" Click="OnCancelUndoPreview"
                                               AutomationProperties.AutomationId="CancelUndoPreviewButton" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Undo Preview Diff / Conflict Explanation Card -->
                        <Border Style="{StaticResource Surface}" Padding="14,10" Margin="0" AutomationProperties.AutomationId="ConfigUndoDiffCard">
                            <StackPanel>
                                <TextBlock Text="{Binding ConfigRestorePoints.UndoDiffHeaderSummary}" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,2"
                                           AutomationProperties.AutomationId="ConfigUndoDiffHeaderSummary" />
                                <TextBlock Text="{Binding ConfigRestorePoints.UndoPreviewDetail}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,6"
                                           AutomationProperties.AutomationId="ConfigUndoPreviewDetail" />

                                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Background="White"
                                        Visibility="{Binding ConfigRestorePoints.HasUndoTextDiff, Converter={StaticResource BoolVisibility}}">
                                    <ItemsControl ItemsSource="{Binding ConfigRestorePoints.UndoDiffLines}" AutomationProperties.AutomationId="ConfigUndoDiffLinesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,2.5" BorderBrush="#F0F3F2" BorderThickness="0,0,0,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="White" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Removed}">
                                                                    <Setter Property="Background" Value="#FFF0ED" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Added}">
                                                                    <Setter Property="Background" Value="#EAF5F1" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Ellipsis}">
                                                                    <Setter Property="Background" Value="#F4F6F6" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding LineNumbersDisplay}"
                                                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                                                                   Foreground="#7A8C87" Margin="0,0,8,0" TextWrapping="NoWrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayLine}"
                                                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#213934" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Removed}">
                                                                            <Setter Property="Foreground" Value="#8F2D1E" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Added}">
                                                                            <Setter Property="Foreground" Value="#0E5A53" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Ellipsis}">
                                                                            <Setter Property="Foreground" Value="#596D68" />
                                                                            <Setter Property="FontStyle" Value="Italic" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <TextBlock Text="{Binding ConfigRestorePoints.UndoDiffFallbackNote}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,5,0,0"
                                           Visibility="{Binding ConfigRestorePoints.HasUndoDiffTruncationNote, Converter={StaticResource BoolVisibility}}" />

                                <Border Background="#F7F9F9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8"
                                        Visibility="{Binding ConfigRestorePoints.ShowUndoDiffFallback, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="{Binding ConfigRestorePoints.UndoDiffFallbackNote}" Style="{StaticResource MutedText}" FontSize="12"
                                               AutomationProperties.AutomationId="ConfigUndoDiffFallbackText" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Empty selection hint -->
                    <Border Style="{StaticResource Surface}" Padding="24" Margin="0"
                            Visibility="{Binding ConfigRestorePoints.HasNoSelectedPoint, Converter={StaticResource BoolVisibility}}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="选择左侧还原点以核对当前状态" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="选中任意还原点后，将只读比对从备份到现在的变化；点击「恢复」会切换为「当前文件 → 恢复后」预览，确认后再写入。"
                                       Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Selected Restore Point Content (Browse or Restore Preview) -->
                    <StackPanel Visibility="{Binding ConfigRestorePoints.ShowSelectedPointPanels, Converter={StaticResource BoolVisibility}}">

                        <!-- TOP-PRIORITY Inline Restore Preview / Confirmation Panel ("当前文件 → 恢复后") -->
                        <Border Background="#FFFBF2" BorderBrush="#D99B26" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                                Visibility="{Binding ConfigRestorePoints.IsConfirmingRestore, Converter={StaticResource BoolVisibility}}"
                                AutomationProperties.AutomationId="ConfigRestoreConfirmCard">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#FDE8C8" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ConfigRestorePoints.ConfirmRestoreDirectionLabel}" Foreground="#7A4300" FontSize="11" FontWeight="SemiBold"
                                                       AutomationProperties.AutomationId="ConfigRestoreDirectionBadge" />
                                        </Border>
                                        <Border Background="#F3EBDD" CornerRadius="4" Padding="7,2">
                                            <TextBlock Text="尚未写入磁盘" Foreground="#6E4E1B" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConfigRestorePoints.ConfirmRestoreTitle}" FontSize="15.5" FontWeight="SemiBold" Foreground="#5C3100"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               AutomationProperties.AutomationId="ConfigRestoreConfirmTitle" />
                                </DockPanel>

                                <!-- Mid-confirmation external edit refresh alert -->
                                <Border Background="#FDE8C8" BorderBrush="#D99B26" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                                        Visibility="{Binding ConfigRestorePoints.HasMidConfirmWarning, Converter={StaticResource BoolVisibility}}"
                                        AutomationProperties.AutomationId="ConfigMidEditWarningBanner">
                                    <TextBlock Text="{Binding ConfigRestorePoints.MidConfirmWarningText}" Foreground="#7A4300" FontSize="12" FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="ConfigMidEditWarningText" />
                                </Border>

                                <!-- Full target path (wraps cleanly so full filename is always readable at high DPI!) -->
                                <Border Background="White" BorderBrush="#E8CFA0" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="0,0,0,5">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="目标路径：" FontSize="11.5" FontWeight="SemiBold" Foreground="#8A4B00" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding ConfigRestorePoints.ConfirmRestoreTargetPath}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" AutomationProperties.AutomationId="ConfigRestoreConfirmTargetPath" />
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="{Binding ConfigRestorePoints.ConfirmRestoreFormatTransition}" FontSize="11.5" Foreground="#6A3C06" Margin="0,0,0,3"
                                           AutomationProperties.AutomationId="ConfigRestoreFormatTransition" />
                                <TextBlock Text="{Binding ConfigRestorePoints.ConfirmRestoreOperationText}" FontSize="12" Foreground="#4A2E0B" LineHeight="17" Margin="0,0,0,8"
                                           AutomationProperties.AutomationId="ConfigRestoreConfirmOperationText" />

                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="确认恢复（覆盖并保留撤销副本）" Appearance="Danger" Padding="14,7" Margin="0,0,8,0"
                                               Click="OnConfirmRestore" IsEnabled="{Binding ConfigRestorePoints.CanConfirmRestore}"
                                               AutomationProperties.AutomationId="ConfirmRestoreButton">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Checkmark24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="取消" Appearance="Secondary" Padding="12,7" Click="OnCancelRestore"
                                               AutomationProperties.AutomationId="CancelRestoreButton" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Normal Browse Detail Header Card (hidden while confirming restore so Confirm + Diff stay above the fold!) -->
                        <Border Style="{StaticResource Surface}" Padding="14,10" Margin="0,0,0,10"
                                Visibility="{Binding ConfigRestorePoints.ShowDetailHeaderCard, Converter={StaticResource BoolVisibility}}"
                                AutomationProperties.AutomationId="ConfigDetailHeaderCard">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Left" CornerRadius="5" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EAF5F1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ConfigRestorePoints.IsStatusChanged}" Value="True">
                                                                <Setter Property="Background" Value="#FFF0D6" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConfigRestorePoints.IsStatusMissing}" Value="True">
                                                                <Setter Property="Background" Value="#FFF0D6" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConfigRestorePoints.IsStatusError}" Value="True">
                                                                <Setter Property="Background" Value="#FDE3DC" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ConfigRestorePoints.ComparisonStatusBadge}" FontSize="11.5" FontWeight="SemiBold"
                                                           AutomationProperties.AutomationId="ConfigComparisonStatusBadge">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0E5A53" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsStatusChanged}" Value="True">
                                                                    <Setter Property="Foreground" Value="#8A4B00" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsStatusMissing}" Value="True">
                                                                    <Setter Property="Foreground" Value="#8A4B00" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConfigRestorePoints.IsStatusError}" Value="True">
                                                                    <Setter Property="Foreground" Value="#8F2D1E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding ConfigRestorePoints.SelectedScopedName}" FontSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ConfigRestorePoints.SelectedTargetPath}"
                                                       VerticalAlignment="Center"
                                                       AutomationProperties.AutomationId="ConfigSelectedScopedName" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                            <Run Text="备注：" /><Run Text="{Binding ConfigRestorePoints.SelectedNoteText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · 创建于 " /><Run Text="{Binding ConfigRestorePoints.SelectedCreatedTime, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <ui:Button Content="重新检查" Appearance="Secondary" Padding="10,6" Margin="0,0,6,0" Click="OnRecheckComparison"
                                                   AutomationProperties.AutomationId="RecheckConfigComparisonButton">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="恢复" Appearance="Primary" Padding="14,6" Click="OnBeginRestore"
                                                   IsEnabled="{Binding ConfigRestorePoints.CanBeginRestore}"
                                                   AutomationProperties.AutomationId="BeginRestoreButton">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowReset24" /></ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#F4F7F6" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,6,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="目标文件：" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" />
                                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding ConfigRestorePoints.SelectedTargetPath, Mode=OneWay}"
                                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" VerticalAlignment="Center"
                                                 AutomationProperties.AutomationId="ConfigSelectedTargetPath" />
                                    </DockPanel>
                                </Border>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F7FAF9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                        <StackPanel>
                                            <TextBlock Text="还原点备份（原始字节）" FontSize="11" FontWeight="SemiBold" Foreground="#0E5A53" />
                                            <TextBlock FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <Run Text="{Binding ConfigRestorePoints.BackupSizeText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding ConfigRestorePoints.BackupFormatText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding ConfigRestorePoints.BackupSha256Text}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ConfigRestorePoints.BackupSha256Text}" Margin="0,1,0,0" AutomationProperties.AutomationId="ConfigBackupSha256" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#F9F9FA" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                        <StackPanel>
                                            <TextBlock Text="当前目标文件" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <Run Text="{Binding ConfigRestorePoints.LiveSizeText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding ConfigRestorePoints.LiveFormatText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding ConfigRestorePoints.LiveSha256Text}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ConfigRestorePoints.LiveSha256Text}" Margin="0,1,0,0" AutomationProperties.AutomationId="ConfigLiveSha256" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Directional Line-by-Line Diff Card (Browse: 从备份到现在 | Restore Preview: 当前文件 → 恢复后) -->
                        <Border Style="{StaticResource Surface}" Padding="14,10" Margin="0" AutomationProperties.AutomationId="ConfigDiffCard">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="7,1.5" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EEF2F2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConfigRestorePoints.IsConfirmingRestore}" Value="True">
                                                        <Setter Property="Background" Value="#FDE8C8" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ConfigRestorePoints.DiffDirectionBadgeText}" FontSize="11" FontWeight="SemiBold"
                                                   AutomationProperties.AutomationId="ConfigDiffDirectionBadge">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#354643" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConfigRestorePoints.IsConfirmingRestore}" Value="True">
                                                            <Setter Property="Foreground" Value="#7A4300" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding ConfigRestorePoints.DiffHeaderSummary}" FontWeight="SemiBold" FontSize="13.5"
                                               AutomationProperties.AutomationId="ConfigDiffHeaderSummary" />
                                </DockPanel>
                                <TextBlock Text="{Binding ConfigRestorePoints.ComparisonDetail}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,6"
                                           AutomationProperties.AutomationId="ConfigComparisonDetail" />

                                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Background="White"
                                        Visibility="{Binding ConfigRestorePoints.HasTextDiff, Converter={StaticResource BoolVisibility}}"
                                        AutomationProperties.AutomationId="ConfigDiffLinesContainer">
                                    <ItemsControl ItemsSource="{Binding ConfigRestorePoints.DiffLines}" AutomationProperties.AutomationId="ConfigDiffLinesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,2.5" BorderBrush="#F0F3F2" BorderThickness="0,0,0,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="White" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Removed}">
                                                                    <Setter Property="Background" Value="#FFF0ED" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Added}">
                                                                    <Setter Property="Background" Value="#EAF5F1" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Ellipsis}">
                                                                    <Setter Property="Background" Value="#F4F6F6" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding LineNumbersDisplay}"
                                                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                                                                   Foreground="#7A8C87" Margin="0,0,8,0" TextWrapping="NoWrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayLine}"
                                                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#213934" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Removed}">
                                                                            <Setter Property="Foreground" Value="#8F2D1E" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Added}">
                                                                            <Setter Property="Foreground" Value="#0E5A53" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:ConfigDiffLineKind.Ellipsis}">
                                                                            <Setter Property="Foreground" Value="#596D68" />
                                                                            <Setter Property="FontStyle" Value="Italic" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <TextBlock Text="{Binding ConfigRestorePoints.DiffFallbackNote}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,5,0,0"
                                           Visibility="{Binding ConfigRestorePoints.HasDiffTruncationNote, Converter={StaticResource BoolVisibility}}" />

                                <Border Background="#F7F9F9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8"
                                        Visibility="{Binding ConfigRestorePoints.ShowDiffFallback, Converter={StaticResource BoolVisibility}}"
                                        AutomationProperties.AutomationId="ConfigDiffFallbackCard">
                                    <TextBlock Text="{Binding ConfigRestorePoints.DiffFallbackNote}" Style="{StaticResource MutedText}" FontSize="12"
                                               AutomationProperties.AutomationId="ConfigDiffFallbackText" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
