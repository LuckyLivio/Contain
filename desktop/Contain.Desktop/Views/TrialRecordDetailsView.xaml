<UserControl x:Class="Contain.Desktop.Views.TrialRecordDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,12,24,24">
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">
            <!-- Top bar: Back + Primary actions -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:Button Content="返回隔离试用历史" Appearance="Transparent" HorizontalAlignment="Left" Padding="0,8" Click="OnBack" AutomationProperties.AutomationId="BackToTrialHistoryButton">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowLeft24" /></ui:Button.Icon>
                </ui:Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="导出本次报告" Appearance="Secondary" Padding="14,8" Margin="0,0,10,0" Click="OnExportReport" IsEnabled="{Binding TrialHistory.HasSelectedRecord}" AutomationProperties.AutomationId="ExportTrialReportButton">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentArrowDown24" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="再次试用" Appearance="Primary" Padding="16,8" Click="OnReplay" IsEnabled="{Binding TrialHistory.HasSelectedRecord}" AutomationProperties.AutomationId="ReplayTrialRecordButton">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" /></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- Title & overall result -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding TrialHistory.DetailTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,4" AutomationProperties.AutomationId="TrialDetailTitle" />
                    <TextBlock Text="{Binding TrialHistory.DetailSubtitle}" Style="{StaticResource MutedText}" AutomationProperties.AutomationId="TrialDetailSubtitle" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="6" Padding="12,5" VerticalAlignment="Center" Margin="16,0,0,0" Background="#E4F1ED">
                    <TextBlock Text="{Binding TrialHistory.DetailOverallResultLabel}" Foreground="#0E5A53" FontSize="13" FontWeight="SemiBold" AutomationProperties.AutomationId="TrialDetailOverallResult" />
                </Border>
            </Grid>

            <!-- Two independent authoritative facts: Sandbox instance state & Host staging cleanup state -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="10" Padding="16" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F2F8F6" />
                            <Setter Property="BorderBrush" Value="#8DC4B7" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TrialHistory.DetailSandboxIsWarning}" Value="True">
                                    <Setter Property="Background" Value="#FFF8EB" />
                                    <Setter Property="BorderBrush" Value="#D99B26" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="沙箱是否确认结束" Style="{StaticResource MutedText}" FontSize="12" />
                        <TextBlock Text="{Binding TrialHistory.DetailSandboxStateLabel}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" AutomationProperties.AutomationId="TrialDetailSandboxState">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0E5A53" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TrialHistory.DetailSandboxIsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#8A4B00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="10" Padding="16" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F2F8F6" />
                            <Setter Property="BorderBrush" Value="#8DC4B7" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TrialHistory.DetailStagingIsWarning}" Value="True">
                                    <Setter Property="Background" Value="#FFF8EB" />
                                    <Setter Property="BorderBrush" Value="#D99B26" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="宿主暂存是否确认清理" Style="{StaticResource MutedText}" FontSize="12" />
                        <TextBlock Text="{Binding TrialHistory.DetailStagingStateLabel}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" AutomationProperties.AutomationId="TrialDetailStagingState">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0E5A53" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TrialHistory.DetailStagingIsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#8A4B00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Trial target & observed launch overview -->
            <Border Style="{StaticResource Surface}">
                <StackPanel>
                    <TextBlock Text="本次试用摘要" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="开始时间" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TrialHistory.DetailStartedTime}" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.AutomationId="TrialDetailStartedTime" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="结束时间" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TrialHistory.DetailEndedTime}" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.AutomationId="TrialDetailEndedTime" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="输入模式" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TrialHistory.DetailInputKindLabel}" Margin="0,0,0,8" AutomationProperties.AutomationId="TrialDetailInputKind" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="所选入口" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TrialHistory.DetailEntryRelativePath}" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.AutomationId="TrialDetailEntryRelativePath" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="入口版本与架构" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" AutomationProperties.AutomationId="TrialDetailEntryMeta">
                            <Run Text="版本：" /><Run Text="{Binding TrialHistory.DetailEntryVersion, Mode=OneWay}" /><Run Text=" · 架构：" /><Run Text="{Binding TrialHistory.DetailEntryArchitecture, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="目录快照范围" Style="{StaticResource MutedText}" Margin="0,0,0,8" Visibility="{Binding TrialHistory.DetailIsFolderMode, Converter={StaticResource BoolVisibility}}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TrialHistory.DetailFolderScopeText}" Margin="0,0,0,8" Visibility="{Binding TrialHistory.DetailIsFolderMode, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TrialDetailFolderScope" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="入口 SHA-256" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                        <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
                            <ui:Button DockPanel.Dock="Right" Content="复制" Appearance="Transparent" Padding="8,2" Margin="8,0,0,0" Click="OnCopyEntrySha256" Visibility="{Binding TrialHistory.DetailHasEntrySha256, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CopyTrialDetailSha256Button" />
                            <TextBox Text="{Binding TrialHistory.DetailEntrySha256, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" VerticalAlignment="Center" AutomationProperties.AutomationId="TrialDetailEntrySha256" AutomationProperties.Name="本次实际传入的入口 SHA-256" />
                        </DockPanel>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="观察到的启动结果" Style="{StaticResource MutedText}" />
                        <StackPanel Grid.Row="7" Grid.Column="1">
                            <TextBlock Text="{Binding TrialHistory.DetailLaunchOutcomeLabel}" FontWeight="SemiBold" AutomationProperties.AutomationId="TrialDetailLaunchOutcome" />
                            <TextBlock Text="{Binding TrialHistory.DetailLaunchSummary}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0" AutomationProperties.AutomationId="TrialDetailLaunchSummary" />
                        </StackPanel>
                    </Grid>

                    <Border Background="#F4F8F7" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4,0,0">
                        <WrapPanel>
                            <Border Background="#E4F1ED" CornerRadius="6" Padding="10,4" Margin="0,0,8,4">
                                <TextBlock Text="关闭网络（离线沙箱）" Foreground="#0E5A53" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#E4F1ED" CornerRadius="6" Padding="10,4" Margin="0,0,8,4">
                                <TextBlock Text="关闭剪贴板共享" Foreground="#0E5A53" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#E4F1ED" CornerRadius="6" Padding="10,4" Margin="0,0,8,4">
                                <TextBlock Text="只读快照挂载" Foreground="#0E5A53" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#E4F1ED" CornerRadius="6" Padding="10,4" Margin="0,0,0,4">
                                <TextBlock Text="关闭后丢弃来宾改动" Foreground="#0E5A53" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Session event timeline (exact same source as JSON report export) -->
            <Border Style="{StaticResource Surface}">
                <StackPanel>
                    <TextBlock Text="本次会话事件时间线" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="以下内容与“导出本次报告”生成的版本化 JSON 完全一致，默认不含宿主机绝对路径、Windows 用户名或原始诊断命令。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding TrialHistory.SelectedTimeline}" AutomationProperties.AutomationId="TrialDetailTimelineList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayTime}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Stage}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Honest evidence boundary note -->
            <Border Background="#F4F6F6" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <TextBlock Text="{Binding TrialHistory.DetailEvidenceScopeNote}" Style="{StaticResource MutedText}" FontSize="12" AutomationProperties.AutomationId="TrialDetailEvidenceScopeNote" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
